class ProfileC(DeepBase):
    """Character icons resolve out of noise, then get interconnected."""
    title = "PROFILE MATCH"
    min_size = (46, 19)
    max_size = (60, 21)
    P = Pal((255, 196, 64), CYAN)

    def __init__(self, ih, iw):
        self.h, self.w = ih, iw
        self.ncol = max(1, min(4, (iw + 3) // 10))
        self.nrow = max(1, min(2, ih // 8))
        n = self.ncol * self.nrow
        names = random.sample(list(ICONS), len(ICONS))
        x00 = (iw - (self.ncol * 10 - 3)) // 2
        self.slots = [(x00 + (i % self.ncol) * 10, 1 + (i // self.ncol) * 8, names[i % len(names)])
                      for i in range(n)]
        order = list(range(n))
        random.shuffle(order)
        self.f0 = [0.04 + order[i] * 0.5 / n for i in range(n)]
        self.pct = [random.randint(78, 99) for _ in range(n)]

    def prog(self, i, fr):
        return (fr - self.f0[i]) / 0.1

    def draw(self, b, t):
        P, fr = self.P, t / self.life
        done = 0
        for i, (x0, y0, name) in enumerate(self.slots):
            p = self.prog(i, fr)
            if p <= 0:
                b.put(y0 + 2, x0 + 2, "···", P.d)
                continue
            ok = min(5, int(p * 6))
            for r in range(5):
                if r < ok:
                    b.put(y0 + r, x0, ICONS[name][r], P.hi if p < 1.2 else P.b)
                else:
                    b.put(y0 + r, x0, "".join(random.choice("░▒▓▚▞") for _ in range(7)), P.d)
            if p >= 1:
                done += 1
                b.put(y0 + 5, x0 + (7 - len(name)) // 2, name, P.s)
                v = min(self.pct[i], int((p - 1) * 40))
                b.put(y0 + 6, x0 + 1, "%3d%% OK" % v, P.m)
        links = 0
        for i, (x0, y0, _) in enumerate(self.slots):
            if self.prog(i, fr) < 1.3:
                continue
            if i % self.ncol and self.prog(i - 1, fr) >= 1.3:
                links += 1
                pulse = int(t * 8 + i) % 3
                for k in range(3):
                    b.put(y0 + 2, x0 - 3 + k, "◆" if k == pulse else "═", P.s if k == pulse else P.m)
            if i >= self.ncol and self.prog(i - self.ncol, fr) >= 1.3:
                links += 1
                b.put(y0 - 1, x0 + 3, "◆" if int(t * 5 + i) % 2 else "║", P.s)
        b.put(b.h - 1, 1, "PROFILES %d/%d  LINKED %d" % (done, len(self.slots), links), P.b)


