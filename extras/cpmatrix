class Canvas:
    def __init__(self, h, w):
        self.h, self.w = h, w
        self.ch = [[" "] * w for _ in range(h)]
        self.st = [[RESET] * w for _ in range(h)]

    def put(self, r, c, ch, s):
        if 0 <= r < self.h and 0 <= c < self.w:
            self.ch[r][c] = ch
            self.st[r][c] = s

    def blit(self, buf, r0, c0):
        for r in range(buf.h):
            rr = r0 + r
            if 0 <= rr < self.h:
                for c in range(buf.w):
                    cc = c0 + c
                    if 0 <= cc < self.w:
                        self.ch[rr][cc] = buf.ch[r][c]
                        self.st[rr][cc] = buf.st[r][c]


