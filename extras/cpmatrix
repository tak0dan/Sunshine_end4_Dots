class LogoC(DeepBase):
    """Block-letter logo assembling out of noise, glitching, dissolving; cycles through names."""
    title = "LOGO ASSEMBLY"
    min_size = (46, 16)
    max_size = (58, 19)
    P = Pal((255, 220, 40), RED)
    CYCLE = 14.0
    WORDS = ["ARASAKA", "MILITECH", "NETWATCH", "BLACKWALL", "KIROSHI", "NIGHT CITY"]

    def __init__(self, ih, iw):
        self.h, self.w = ih, iw
        self.order = ["CYBERPUNK"] + random.sample(self.WORDS, len(self.WORDS))
        self.cache = {}

    def pixels(self, text, row0, delay, red):
        total = len(text) * 4 - 1
        x0 = (self.w - total) // 2
        out = []
        for i, ch in enumerate(text):
            g = FONT.get(ch)
            for r in range(5):
                for c in range(3):
                    if g and g[r][c] == "█":
                        x = x0 + i * 4 + c
                        a = delay + (x - x0) / max(1, total) * 2.2 + random.uniform(0, 1.4)
                        out.append((row0 + r, x, a, 10.4 + random.uniform(0, 3.2), red))
        return out

    def draw(self, b, t):
        P = self.P
        cyc = int(t / self.CYCLE)
        u = t % self.CYCLE
        word = self.order[cyc % len(self.order)]
        if cyc not in self.cache:
            self.cache = {cyc: self.pixels(word, 1, 0.0, False) + self.pixels("2077", 8, 0.8, True)}
        sweep = (u - 5.5) / 3.0 * (self.w + 8) - 4
        jr = jd = None
        if 4.4 < u < 10.2 and random.random() < 0.06:
            jr, jd = random.randint(1, 12), random.choice((-2, -1, 1, 2))
        for r, c, a, d, red in self.cache[cyc]:
            if u < a - 0.5 or u >= d + 0.4:
                continue
            if u < a or u >= d:
                b.put(r, c, random.choice("░▒▓01"), P.d)
                continue
            s = P.hi if (u - a < 0.35 or abs(c - sweep) < 2) else (P.s if red else P.b)
            if r == jr:
                b.put(r, c + jd, "█", P.s)
            else:
                b.put(r, c, "█", s)
        b.put(0, 1, "RENDER  %s" % word, P.m)
        b.put(b.h - 1, 1, "ASSET 0x%s%s" % (rs(), rs()) if u < 4.5 else "VERIFIED // 0x%s" % rs(), P.d)


