class DbDescentC(DeepBase):
    """Query tree growing level by level, ending on the highlighted path to the target record."""
    title = "DB QUERY"
    min_size = (44, 16)
    max_size = (60, 22)
    P = Pal(YEL, CYAN)

    def __init__(self, ih, iw):
        self.h, self.w = ih, iw
        self.levels = max(3, min(10, (ih - 3) // 2))
        self.nodes = []
        self.root = self.build(0, 1, iw - 1, None, 0.0)
        mf = max(n["f"] for n in self.nodes) or 1.0
        for n in self.nodes:
            n["f"] *= 0.82 / mf
        node = max(self.nodes, key=lambda n: (n["lv"], n["hit"]))
        self.target = node
        self.path = set()
        while node:
            self.path.add(id(node))
            node = node["par"]

    def build(self, lv, x0, x1, par, f):
        n = {"lv": lv, "x": (x0 + x1) // 2, "ch": [], "par": par, "f": f,
             "id": rs() + rs(), "hit": random.random() < 0.18}
        self.nodes.append(n)
        if lv < self.levels - 1 and x1 - x0 >= 1:
            k = 3 if lv == 0 else random.choices((0, 1, 2, 3), (0.04, 0.6, 0.3, 0.06))[0]
            k = min(k, max(1, (x1 - x0) // 3))
            span = (x1 - x0) / max(1, k)
            for i in range(k):
                n["ch"].append(self.build(lv + 1, int(x0 + i * span), int(x0 + (i + 1) * span + (k == 1)),
                                          n, f + random.uniform(0.02, 0.07)))
        return n

    def draw(self, b, t):
        P, fr = self.P, t / self.life
        vis = [n for n in self.nodes if fr >= n["f"]]
        depth = max(n["lv"] for n in vis) + 1
        b.put(0, 1, "DEPTH %02d/%02d" % (depth, self.levels), P.b)
        b.put(0, 16, "RECORDS %s" % format(len(vis) * 173 + int(t * 31) % 173, ","), P.m)
        for n in self.nodes:
            if fr < n["f"] or not n["ch"]:
                continue
            r, px = 1 + n["lv"] * 2, n["x"]
            dirs = {"U"}
            for ch in n["ch"]:
                if fr < ch["f"]:
                    continue
                cx = ch["x"]
                for x in range(min(px, cx) + 1, max(px, cx)):
                    b.put(r + 1, x, "─", P.d)
                if cx == px:
                    dirs.add("D")
                else:
                    dirs.add("L" if cx < px else "R")
                    b.put(r + 1, cx, "┌" if cx < px else "┐", P.d)
            b.put(r + 1, px, JUNC.get(frozenset(dirs), "│"), P.d)
        final = fr > 0.88
        for n in vis:
            r, x = 1 + n["lv"] * 2, n["x"]
            fresh = (fr - n["f"]) * self.life < 1.2
            if final and id(n) in self.path:
                b.put(r, x, "◈", P.s)
            elif n["hit"]:
                b.put(r, x, "◆", P.s)
                b.put(r, x + 2, n["id"], P.sd)
            else:
                b.put(r, x, "●", P.hi if fresh else P.m)
        b.put(1 + (depth - 1) * 2, 0, "▶", P.s)
        if final and blink(t):
            b.put(b.h - 1, 1, "TARGET FOUND ▸ %s" % self.target["id"], P.s)


def line_cells(p0, p1):
    (r0, c0), (r1, c1) = p0, p1
    dr, dc = r1 - r0, c1 - c0
    rd, cd = abs(dr), abs(dc) / 2
    ch = "─" if cd > 2.5 * rd else "│" if rd > 2.5 * cd else ("╲" if dr * dc > 0 else "╱")
    cells, last = [], None
    steps = max(abs(dc), abs(dr) * 2, 1)
    for k in range(1, steps):
        p = (round(r0 + dr * k / steps), round(c0 + dc * k / steps))
        if p != last and p != p0 and p != p1:
            cells.append((p[0], p[1], ch))
            last = p
    return cells


class ConnMapC(DeepBase):
    """Graph of people/entities appearing, then links found between them."""
    title = "CONNECTION MAP"
    min_size = (40, 14)
    max_size = (56, 20)
    P = Pal(CYAN, YEL)

    def __init__(self, ih, iw):
        self.h, self.w = ih, iw
        n = max(6, min(14, ih * iw // 70))
        self.pts = []
        for _ in range(400):
            if len(self.pts) >= n:
                break
            r, c = random.randint(1, ih - 2), random.randint(2, max(2, iw - 12))
            if all(math.hypot((c - pc) / 2, r - pr) >= 4 for pr, pc in self.pts):
                self.pts.append((r, c))
        n = len(self.pts)
        names = random.sample(NAMES, min(n, len(NAMES)))
        self.names = [names[i] if i < len(names) else rs() + rs() for i in range(n)]
        self.nf = sorted(random.uniform(0.02, 0.55) for _ in range(n))
        self.edges = []
        for i in range(1, n):
            near = sorted(range(i), key=lambda j: math.hypot((self.pts[i][1] - self.pts[j][1]) / 2,
                                                            self.pts[i][0] - self.pts[j][0]))
            for j in near[: 1 + (random.random() < 0.3) + (random.random() < 0.06)]:
                self.add_edge(j, i)
        for _ in range(n // 5):
            a, c = random.sample(range(n), 2) if n > 1 else (0, 0)
            far = math.hypot((self.pts[a][1] - self.pts[c][1]) / 2, self.pts[a][0] - self.pts[c][0]) > 14
            if a != c and not far and not any({a, c} == {e[0], e[1]} for e in self.edges):
                self.add_edge(min(a, c), max(a, c), late=True)

    def add_edge(self, j, i, late=False):
        f = max(self.nf[i], self.nf[j]) + random.uniform(0.01, 0.05)
        if late:
            f = random.uniform(0.5, 0.85)
        self.edges.append((j, i, f, line_cells(self.pts[j], self.pts[i])))

    def draw(self, b, t):
        P, fr = self.P, t / self.life
        links = 0
        for k, (j, i, f, cells) in enumerate(self.edges):
            if fr < f:
                continue
            links += 1
            age = (fr - f) * self.life
            for r, c, ch in cells:
                b.put(r, c, ch, P.hi if age < 0.7 else P.d)
            if cells and age >= 0.7:
                r, c, ch = cells[int(t * 10 + k * 7) % len(cells)]
                b.put(r, c, ch, P.b)
        shown = sum(1 for f in self.nf if fr >= f)
        for (r, c), name, f in zip(self.pts, self.names, self.nf):
            if fr < f:
                continue
            fresh = (fr - f) * self.life < 1.0
            b.put(r, c, "◉", P.hi if fresh else P.b)
            b.put(r, c + 2, name, P.s if fresh else P.m)
        b.put(0, 1, "NODES %d  LINKS %d" % (shown, links), P.b)
        if fr > 0.9 and blink(t):
            b.put(b.h - 1, 1, "NETWORK MAPPED", P.s)


