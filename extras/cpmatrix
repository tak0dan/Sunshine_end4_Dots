JUNC = {frozenset("UD"): "│", frozenset("UL"): "┘", frozenset("UR"): "└", frozenset("ULR"): "┴",
        frozenset("UDL"): "┤", frozenset("UDR"): "├", frozenset("UDLR"): "┼"}
NAMES = ["V", "JOHNNY", "JUDY", "PANAM", "ROGUE", "JACKIE", "ALT", "TAKEMURA", "KERRY", "SASHA",
