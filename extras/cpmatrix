class Sys:
    INTERVAL = 0.5
    FS = {"ext4", "ext3", "ext2", "btrfs", "xfs", "f2fs", "vfat", "exfat", "ntfs", "ntfs3", "zfs", "fuseblk"}
    DISK_RE = re.compile(r"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme\d+n\d+|mmcblk\d+)$")

    def __init__(self):
        self.t = 0.0
        self.ncpu = os.cpu_count() or 1
        self.cpu_prev, self.cpu = {}, {}
        self.cpu_hist = deque([0.0] * 400, maxlen=400)
        self.mem = {"total": 1, "used": 0, "avail": 0, "cached": 0, "swap_total": 0, "swap_used": 0}
        self.mem_hist = deque([0.0] * 400, maxlen=400)
        self.net_prev = None
        self.rx = self.tx = 0.0
        self.rx_tot = self.tx_tot = 0
        self.rx_hist = deque([0.0] * 400, maxlen=400)
        self.tx_hist = deque([0.0] * 400, maxlen=400)
        self.io_prev = None
        self.rd = self.wr = 0.0
        self.io_hist = deque([0.0] * 400, maxlen=400)
        self.temp = None
        self.temp_t = 0.0
        self.disks = []
        self.disk_t = 0.0
        self.procs = []
        self.proc_prev = {}
        self.proc_t = 0.0
        self.tick = os.sysconf("SC_CLK_TCK")
        self.page = os.sysconf("SC_PAGE_SIZE")
        self.mounts = self.find_mounts()

    def find_mounts(self):
        seen, out = set(), []
        try:
            with open("/proc/mounts") as f:
                for line in f:
                    dev, mnt, fs = line.split()[:3]
                    if fs in self.FS and dev not in seen:
                        seen.add(dev)
                        out.append(mnt.replace("\\040", " "))
        except OSError:
            pass
        return out[:6]

    def update(self, now, want_procs):
        dt = now - self.t
        if dt < self.INTERVAL:
            return
        self.t = now
        for fn, args in ((self.read_cpu, ()), (self.read_mem, ()), (self.read_net, (dt,)), (self.read_io, (dt,))):
            try:
                fn(*args)
            except (OSError, ValueError, IndexError, ZeroDivisionError):
                pass
        if now - self.temp_t > 2:
            self.temp_t = now
            self.read_temp()
        if now - self.disk_t > 5:
            self.disk_t = now
            self.read_disks()
        if want_procs and now - self.proc_t >= 2:
            try:
                self.read_procs(now)
            except (OSError, ValueError, IndexError):
                pass

    def read_cpu(self):
        cur = {}
        with open("/proc/stat") as f:
            for line in f:
                if not line.startswith("cpu"):
                    break
                p = line.split()
                v = list(map(int, p[1:9]))
                cur[p[0]] = (sum(v), v[3] + v[4])
        for k, (tot, idle) in cur.items():
            if k in self.cpu_prev:
                pt, pi = self.cpu_prev[k]
                if tot - pt > 0:
                    self.cpu[k] = 100.0 * (1 - (idle - pi) / (tot - pt))
        self.cpu_prev = cur
        self.cpu_hist.append(self.cpu.get("cpu", 0.0))

    def read_mem(self):
        d = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                d[k] = int(v.split()[0])
        total = d["MemTotal"]
        avail = d.get("MemAvailable", d.get("MemFree", 0))
        self.mem = {"total": total, "used": total - avail, "avail": avail,
                    "cached": d.get("Cached", 0) + d.get("Buffers", 0),
                    "swap_total": d.get("SwapTotal", 0),
                    "swap_used": d.get("SwapTotal", 0) - d.get("SwapFree", 0)}
        self.mem_hist.append((total - avail) / total)

    def read_net(self, dt):
        rx = tx = 0
        with open("/proc/net/dev") as f:
            for line in list(f)[2:]:
                name, data = line.split(":", 1)
                if name.strip() == "lo":
                    continue
                v = data.split()
                rx += int(v[0])
                tx += int(v[8])
        self.rx_tot, self.tx_tot = rx, tx
        if self.net_prev:
            self.rx = max(0.0, (rx - self.net_prev[0]) / dt)
            self.tx = max(0.0, (tx - self.net_prev[1]) / dt)
            self.rx_hist.append(self.rx)
            self.tx_hist.append(self.tx)
        self.net_prev = (rx, tx)

    def read_io(self, dt):
        rd = wr = 0
        with open("/proc/diskstats") as f:
            for line in f:
                p = line.split()
                if self.DISK_RE.match(p[2]):
                    rd += int(p[5]) * 512
                    wr += int(p[9]) * 512
        if self.io_prev:
            self.rd = max(0.0, (rd - self.io_prev[0]) / dt)
            self.wr = max(0.0, (wr - self.io_prev[1]) / dt)
            self.io_hist.append(self.rd + self.wr)
        self.io_prev = (rd, wr)

    def read_temp(self):
        best = None
        for p in glob.glob("/sys/class/thermal/thermal_zone*/temp") + glob.glob("/sys/class/hwmon/hwmon*/temp1_input"):
            try:
                with open(p) as f:
                    v = int(f.read()) / 1000.0
                best = v if best is None else max(best, v)
            except (OSError, ValueError):
                pass
        self.temp = best

    def read_disks(self):
        out = []
        for m in self.mounts:
            try:
                s = os.statvfs(m)
            except OSError:
                continue
            total = s.f_blocks * s.f_frsize
            if total:
                out.append((m, total, total - s.f_bavail * s.f_frsize))
        self.disks = out

    def read_procs(self, now):
        dtp = now - self.proc_t if self.proc_t else 0
        self.proc_t = now
        cur, rows = {}, []
        mem_b = self.mem["total"] * 1024
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                with open("/proc/%s/stat" % pid) as f:
                    data = f.read()
            except OSError:
                continue
            i = data.rfind(")")
            name = data[data.find("(") + 1:i]
            f_ = data[i + 2:].split()
            ticks = int(f_[11]) + int(f_[12])
            rss = int(f_[21]) * self.page
            cur[pid] = ticks
            cpu = 0.0
            if dtp and pid in self.proc_prev:
                cpu = (ticks - self.proc_prev[pid]) / self.tick / dtp * 100
            rows.append((int(pid), name, cpu, rss / mem_b * 100))
        self.proc_prev = cur
        rows.sort(key=lambda x: (-x[2], -x[3]))
        self.procs = rows[:24]


