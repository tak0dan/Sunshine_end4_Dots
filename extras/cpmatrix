CODES = ["1C", "55", "BD", "E9", "7A", "FF"]
HEX = "0123456789ABCDEF"

YEL = (208, 237, 87)
HEAD = (236, 255, 172)
CYAN = (97, 242, 245)
RED = (255, 75, 75)
DIM = (22, 30, 11)
GUIDE_BG = (44, 56, 14)
BLACK = (8, 10, 4)
WBG = (9, 12, 5)

FLOOR = 0.13


def rt():
    return random.choice(CODES)


def rs():
    return random.choice(HEX) + random.choice(HEX)


def mix(a, b, t):
    return tuple(int(x + (y - x) * t) for x, y in zip(a, b))


def st(f, b=None, bold=False):
    s = "\x1b[0" + (";1" if bold else "") + ";38;2;%d;%d;%d" % f
    if b:
        s += ";48;2;%d;%d;%d" % b
    return s + "m"


# background styles (no bg so transparent terminals show through)
LEVELS = 16
PALETTE = [st(mix(DIM, YEL, (i / (LEVELS - 1)) ** 1.3)) for i in range(LEVELS)]
BG_HEAD = st(HEAD, None, True)
BG_SCR = st(CYAN)

# window styles
W_Y = st(YEL, WBG)
W_YD = st(mix(DIM, YEL, 0.5), WBG)
W_YB = st(YEL, WBG, True)
W_C = st(CYAN, WBG, True)
W_CD = st(mix(DIM, CYAN, 0.5), WBG)
W_R = st(RED, WBG, True)
W_INV = st(BLACK, YEL, True)
W_CINV = st(BLACK, CYAN, True)
W_GUIDE = st(YEL, GUIDE_BG)
W_BORDER = st(mix(DIM, YEL, 0.6), WBG)
W_EDGE = st(CYAN, WBG, True)
GLITCH_STYLES = (st(RED, None, True), st(CYAN, None, True), st(HEAD, None, True))
FLASH_STYLES = (st(BLACK, CYAN, True), st(BLACK, RED, True), st(BLACK, YEL, True))
L_LINE = st(mix(DIM, YEL, 0.65))
L_PULSE = st(CYAN, None, True)
RESET = "\x1b[0m"

# green -> yellow -> red value gradient for graphs and bars
_LOW = (120, 150, 50)
GRAD = [st(mix(_LOW, YEL, i / 5) if i < 6 else mix(YEL, RED, (i - 5) / 4), WBG) for i in range(10)]
BLOCKS = " ▁▂▃▄▅▆▇█"


def vstyle(f):
    return GRAD[int(max(0.0, min(1.0, f)) * 9)]


class Buf:
    def __init__(self, h, w, sty):
        self.h, self.w = h, w
        self.ch = [[" "] * w for _ in range(h)]
        self.st = [[sty] * w for _ in range(h)]

    def put(self, r, c, text, sty=None):
        if not 0 <= r < self.h:
            return
        for i, x in enumerate(text):
            cc = c + i
            if 0 <= cc < self.w:
                self.ch[r][cc] = x
                if sty:
                    self.st[r][cc] = sty

    def border(self, title=None, bs=W_BORDER, ts=W_YB):
        h, w = self.h, self.w
        if h < 2 or w < 2:
            return
        self.put(0, 0, "┌" + "─" * (w - 2) + "┐", bs)
        self.put(h - 1, 0, "└" + "─" * (w - 2) + "┘", bs)
        for r in range(1, h - 1):
            self.put(r, 0, "│", bs)
            self.put(r, w - 1, "│", bs)
        if title:
            self.put(0, 2, "┤", bs)
            self.put(0, 3, " " + title + " ", ts)
            self.put(0, 5 + len(title), "├", bs)

    def blit(self, src, r0, c0):
        for r in range(src.h):
            for c in range(src.w):
                if 0 <= r0 + r < self.h and 0 <= c0 + c < self.w:
                    self.ch[r0 + r][c0 + c] = src.ch[r][c]
                    self.st[r0 + r][c0 + c] = src.st[r][c]


def blink(t, hz=3):
    return int(t * hz) % 2 == 0


def graph(b, r0, c0, h, w, data, maxv, sty=None):
    if h < 1 or w < 1:
        return
    vals = list(data)[-w:]
    off = w - len(vals)
    for i, v in enumerate(vals):
        f = max(0.0, min(1.0, v / maxv)) if maxv else 0.0
        e = int(f * h * 8 + 0.5)
        if e == 0:
            b.put(r0 + h - 1, c0 + off + i, "▁", W_YD)
            continue
        s = sty or vstyle(f)
        for k in range(h):
            n = max(0, min(8, e - k * 8))
            if n:
                b.put(r0 + h - 1 - k, c0 + off + i, BLOCKS[n], s)


def bar(b, r, c, w, f, sty=None):
    if w < 1:
        return
    f = max(0.0, min(1.0, f))
    n = int(f * w + 0.5)
    b.put(r, c, "█" * n, sty or vstyle(f))
    b.put(r, c + n, "░" * (w - n), W_YD)


def fmt_b(n):
    for u in "BKMGT":
        if n < 1024 or u == "T":
            return ("%.0f%s" if u == "B" else "%.1f%s") % (n, u)
        n /= 1024.0


