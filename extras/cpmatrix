class Win:
    IN = 0.5
    OUT = 0.45

    def __init__(self, kind, r, c, h, w, now, life, chain_at=None, level=None):
        self.kind = kind
        self.group = kind.group
        self.level = level
        self.r, self.c, self.h, self.w = r, c, h, w
        self.cont = kind(h - 2, w - 2)
        if hasattr(self.cont, "set_life"):
            self.cont.set_life(life)
        self.t0 = now
        self.cstart = now + self.IN
        self.life = life
        self.run_end = now + self.IN + life
        self.chain_at = chain_at
        self.intro = random.choice(FX)
        self.outro = random.choice(FX)
        self.noise = [[random.random() for _ in range(w)] for _ in range(h)]

    def done(self, now):
        return now > self.run_end + self.OUT

    def ctime(self, now, run):
        ct = now - self.cstart
        if run and ct > self.cont.duration:
            self.cont = self.kind(self.h - 2, self.w - 2)
            self.cstart = now
            ct = 0.0
        return min(ct, self.cont.duration)

    def compose(self, ct, now):
        full = Buf(self.h, self.w, W_Y)
        inner = Buf(self.h - 2, self.w - 2, W_Y)
        self.cont.draw(inner, ct)
        full.blit(inner, 1, 1)
        title = self.cont.title
        if self.level is not None:
            title += " // L%d" % (self.level + 1)
        pal = getattr(self.cont, "P", None)
        full.border(title, pal.border if pal else W_BORDER, pal.title if pal else W_YB)
        if self.group == "sys":
            full.put(0, self.w - 9, " T-%02d " % max(0, int(self.run_end - now + 0.99)), W_YD)
        return full

    def draw(self, cv, now):
        t = now - self.t0
        if t < self.IN:
            q, fx, ct = t / self.IN, self.intro, 0.0
        elif now < self.run_end:
            q, fx, ct = 1.0, None, self.ctime(now, True)
        elif now < self.run_end + self.OUT:
            q, fx, ct = 1 - (now - self.run_end) / self.OUT, self.outro, self.ctime(now, False)
        else:
            return
        full = self.compose(ct, now)
        h, w = self.h, self.w
        if q >= 1:
            cv.blit(full, self.r, self.c)
        elif fx == "wipe":
            n = math.ceil(h * q)
            for r in range(n):
                edge = r == n - 1
                for c in range(w):
                    ch, s = full.ch[r][c], full.st[r][c]
                    if edge:
                        ch, s = ("─" if ch == " " else ch), W_EDGE
                    cv.put(self.r + r, self.c + c, ch, s)
        elif fx == "expand":
            hh, ww = max(2, round(h * q)), max(3, round(w * q))
            box = Buf(hh, ww, W_Y)
            box.border()
            cv.blit(box, self.r + (h - hh) // 2, self.c + (w - ww) // 2)
        elif fx == "border":
            path = ([(0, c) for c in range(w)] + [(r, w - 1) for r in range(1, h)]
                    + [(h - 1, c) for c in range(w - 2, -1, -1)] + [(r, 0) for r in range(h - 2, 0, -1)])
            for r, c in path[: int(q * len(path))]:
                cv.put(self.r + r, self.c + c, full.ch[r][c], full.st[r][c])
        else:  # dissolve
            for r in range(h):
                for c in range(w):
                    nz = self.noise[r][c]
                    if nz < q:
                        cv.put(self.r + r, self.c + c, full.ch[r][c], full.st[r][c])
                    elif nz < q + 0.12:
                        cv.put(self.r + r, self.c + c, random.choice(HEX), W_C)


CORNER = {frozenset("LR"): "─", frozenset("UD"): "│", frozenset("RD"): "┌",
          frozenset("LD"): "┐", frozenset("RU"): "└", frozenset("LU"): "┘"}


def link_path(a, b, side):
    """Orthogonal connector from window a to window b (b lies on `side` of a)."""
    if side in "RL":
        x0 = a.c + a.w if side == "R" else a.c - 1
        x1 = b.c - 1 if side == "R" else b.c + b.w
        y0, y1 = a.r + a.h // 2, b.r + b.h // 2
        xm = (x0 + x1) // 2
        corners = [(y0, x0), (y0, xm), (y1, xm), (y1, x1)]
    else:
        y0 = a.r + a.h if side == "D" else a.r - 1
        y1 = b.r - 1 if side == "D" else b.r + b.h
        x0, x1 = a.c + a.w // 2, b.c + b.w // 2
        ym = (y0 + y1) // 2
        corners = [(y0, x0), (ym, x0), (ym, x1), (y1, x1)]
    pts = [corners[0]]
    for p, q in zip(corners, corners[1:]):
        dr = (q[0] > p[0]) - (q[0] < p[0])
        dc = (q[1] > p[1]) - (q[1] < p[1])
        r, c = p
        while (r, c) != q:
            r, c = r + dr, c + dc
            pts.append((r, c))
    out = []
    for i, (r, c) in enumerate(pts):
        dirs = set()
        for j in (i - 1, i + 1):
            if 0 <= j < len(pts):
                pr, pc = pts[j]
                dirs.add("U" if pr < r else "D" if pr > r else "L" if pc < c else "R")
        if len(dirs) == 1:
            d = next(iter(dirs))
            dirs.add({"U": "D", "D": "U", "L": "R", "R": "L"}[d])
        out.append((r, c, CORNER.get(frozenset(dirs), "─")))
    return out


def make_branches(path, depth=2):
    """Tree-like side branches growing off a connector: (r, c, ch, delay, is_end)."""
    cells = []
    if len(path) < 10:
        return cells

    def grow(r, c, dr, dc, delay, level):
        ln = random.randint(2, 5 if level == 0 else 3)
        ch = "│" if dc == 0 else "─"
        for k in range(1, ln + 1):
            cells.append((r + dr * k, c + dc * k, ch, delay + k * 0.15, k == ln))
        er, ec = r + dr * ln, c + dc * ln
        if level < depth - 1 and random.random() < 0.7:
            for sd in (-1, 1):
                if random.random() < 0.75:
                    grow(er, ec, *((0, sd) if dc == 0 else (sd, 0)), delay + ln * 0.15 + 0.2, level + 1)

    for _ in range(random.randint(3, 6)):
        i = random.randrange(3, len(path) - 3)
        r, c, _ch = path[i]
        horiz = r == path[i - 1][0]
        d = random.choice((-1, 1))
        grow(r, c, *((d, 0) if horiz else (0, d)), random.uniform(0, 12), 0)
    return cells


class Link:
    def __init__(self, a, b, path, t0, line=L_LINE, pulse=L_PULSE, branches=()):
        self.a, self.b, self.path, self.t0 = a, b, path, t0
        self.line, self.pulse, self.branches = line, pulse, branches

    def alive(self, now):
        return now < min(self.a.run_end, self.b.run_end)

    def draw(self, cv, now):
        if now < self.t0:
            return
        n = len(self.path)
        g = min(1.0, (now - self.t0) / 0.5)
        for i in range(int(n * g)):
            r, c, ch = self.path[i]
            cv.put(r, c, ch, self.line)
        if g >= 1:
            age = now - self.t0 - 0.5
            for r, c, ch, dl, end in self.branches:
                if age >= dl:
                    cv.put(r, c, ("◆" if blink(now, 2) else "◇") if end else ch, self.pulse if end else self.line)
        if g >= 1 and n:
            head = int((now - self.t0) * 22)
            for k, h in enumerate((head % (n + 6), n - 1 - (head + n // 2) % (n + 6))):
                for j in range(4):
                    idx = h - j if k == 0 else h + j
                    if 0 <= idx < n:
                        r, c, ch = self.path[idx]
                        cv.put(r, c, "◆" if j == 0 else ch, self.pulse)


