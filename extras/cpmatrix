        area = w * h
        self.cap = {
            "hack": 0 if args.no_hack else (args.max_hack if args.max_hack is not None
                                            else min(20, max(2, area // 320))),
            "sys": 0 if args.no_widgets else (args.max_widgets if args.max_widgets is not None
                                              else min(12, max(1, area // 600))),
        }
        self.reserved, self.deep, self.deep_cool = [], None, 0.0
        now = time.monotonic()
        self.next_spawn = {g: now + random.uniform(0.5, 1.5) for g in self.cap}
        self.glitch = []
        g = args.glitch_every
        self.next_glitch = now + random.uniform(g * 0.5, g * 1.5)

    def new_drop(self, y):
        speed = random.uniform(7, 26) * self.args.speed
        return [y, speed, speed / random.randint(7, 20)]

    # ---- window management

    def free(self, r, c, h, w):
        if r < 0 or c < 0 or r + h > self.h or c + w > self.w:
            return False
        rects = [(o.r, o.c, o.h, o.w) for o in self.wins] + self.reserved
        return all(r + h + 1 <= orr or orr + oh + 1 <= r or c + w + 2 <= oc or oc + ow + 2 <= c
                   for orr, oc, oh, ow in rects)

    def add_win(self, kind, r, c, h, w, now, life=None, level=None):
        if life is None:
            life = random.uniform(self.args.min_life, self.args.max_life)
        chain_at = None
        if kind.group == "hack" and random.random() < 0.35:
            chain_at = now + Win.IN + life * random.uniform(0.3, 0.7)
        win = Win(kind, r, c, h, w, now, life, chain_at, level)
        self.wins.append(win)
        return win

    def rand_size(self, kind):
        (minw, minh), (maxw, maxh) = kind.min_size, kind.max_size
        maxw, maxh = min(maxw, self.w - 2), min(maxh, self.h - 2)
        if maxw < minw or maxh < minh:
            return None
        return random.randint(minw, maxw), random.randint(minh, maxh)

    def place_adjacent(self, anchor, kind):
        sides = list("RLDU")
        random.shuffle(sides)
        for side in sides:
            for _ in range(8):
                size = self.rand_size(kind)
                if not size:
                    return None
                w, h = size
                if side in "RL":
                    g = random.randint(3, 7)
                    c = anchor.c + anchor.w + g if side == "R" else anchor.c - g - w
                    r = anchor.r + random.randint(-(h - 4), anchor.h - 4)
                else:
                    g = random.randint(2, 4)
                    r = anchor.r + anchor.h + g if side == "D" else anchor.r - g - h
                    c = anchor.c + random.randint(-(w - 8), anchor.w - 8)
                if self.free(r, c, h, w):
                    return r, c, h, w, side
        return None

    def connect(self, a, b, side, now, handshake=True, deep=False):
        path = link_path(a, b, side)
        if deep:
            P = b.cont.P
            self.links.append(Link(a, b, path, b.t0 + Win.IN, P.line, P.pulse, make_branches(path)))
        else:
            self.links.append(Link(a, b, path, b.t0 + Win.IN))
        if handshake and sum(1 for w in self.wins if w.kind is HandshakeC) < 2:
            anchor = random.choice((a, b))
            pos = self.place_adjacent(anchor, HandshakeC)
            if pos:
                hs = self.add_win(HandshakeC, *pos[:4], now)
                self.connect(anchor, hs, pos[4], now, handshake=False)

    def chain(self, anchor, now):
        counts = Counter(w.kind for w in self.wins)
        kinds = [k for k in HACKS if counts[k] < 3]
        random.shuffle(kinds)
        for kind in kinds:
            pos = self.place_adjacent(anchor, kind)
            if pos:
                self.connect(anchor, self.add_win(kind, *pos[:4], now), pos[4], now)
                return

    def start_deep(self, now):
        """Rare ~200 s event: a chain of 2-5 consecutive windows, each a unique search animation."""
        n = random.randint(2, 5)
        plan, anchor = [], None
        for kind in random.sample(DEEPS, n):
            if anchor is None:
                size, pos = self.rand_size(kind), None
                for _ in range(60 if size else 0):
                    w, h = size
                    r, c = random.randint(0, self.h - h), random.randint(0, self.w - w)
                    if self.free(r, c, h, w):
                        pos = (r, c, h, w, None)
                        break
            else:
                pos = self.place_adjacent(anchor, kind)
            if not pos:
                break
            self.reserved.append(pos[:4])
            plan.append({"kind": kind, "pos": pos, "win": None})
            anchor = SimpleNamespace(r=pos[0], c=pos[1], h=pos[2], w=pos[3])
        if len(plan) < 2:
            for p in plan:
                self.reserved.remove(p["pos"][:4])
            return False
        total = self.args.deep_length
        gap = min(random.uniform(18, 32), max(2.0, (total - 40) / (len(plan) - 1)))
        for i, p in enumerate(plan):
            p["t"] = now + i * gap
            end = now + total - (len(plan) - 1 - i) * random.uniform(3, 7)
            p["life"] = max(8.0, end - p["t"] - Win.IN - Win.OUT)
        self.deep = {"plan": plan, "end": now + total}
        return True

    def spawn(self, group, now):
        if self.deep is None and now > self.deep_cool and random.randrange(self.args.deep_odds) == 0:
            if self.start_deep(now):
                return
        counts = Counter(w.kind for w in self.wins)
        kinds = [k for k in (HACKS if group == "hack" else WIDGETS) if counts[k] < (3 if group == "hack" else 2)]
        random.shuffle(kinds)
        if group == "hack" and random.random() < 0.3:
            linked = {id(x) for l in self.links for x in (l.a, l.b)}
            anchors = [w for w in self.wins if w.group == "hack" and id(w) not in linked
                       and now - w.t0 > Win.IN and now < w.run_end - 3]
            random.shuffle(anchors)
            for anchor in anchors[:1]:
                for kind in kinds:
                    pos = self.place_adjacent(anchor, kind)
                    if pos:
                        self.connect(anchor, self.add_win(kind, *pos[:4], now), pos[4], now)
                        return
        for kind in kinds:
            size = self.rand_size(kind)
            if not size:
                continue
            for _ in range(30):
                w, h = size
                r, c = random.randint(0, self.h - h), random.randint(0, self.w - w)
                if self.free(r, c, h, w):
                    self.add_win(kind, r, c, h, w, now)
                    return

    # ---- simulation

    def step(self, dt, now):
        R, C = self.R, self.C
        br, scr, tok = self.br, self.scr, self.tok
        for c in range(C):
            d = self.drops[c]
            y0 = d[0]
            d[0] += d[1] * dt
            for r in range(max(0, math.ceil(y0)), min(R, math.ceil(d[0]))):
                tok[r][c] = rt()
                br[r][c] = 1.0
                if random.random() < 0.75:
                    scr[r][c] = random.randint(3, 7)
            if d[0] - 24 > R:
                self.drops[c] = self.new_drop(random.uniform(-R * 0.6, 0))
            dec = d[2] * dt
            for r in range(R):
                b = br[r][c]
                if b > FLOOR:
                    br[r][c] = max(FLOOR, b - dec)
                if scr[r][c]:
                    scr[r][c] -= 1
        for _ in range(max(1, R * C // 400)):
            r, c = random.randrange(R), random.randrange(C)
            tok[r][c] = rt()
            br[r][c] = max(br[r][c], 0.4)

        SYS.update(now, any(w.kind is ProcW for w in self.wins))

        self.wins = [w for w in self.wins if not w.done(now)]
        self.links = [l for l in self.links if l.alive(now) and l.a in self.wins and l.b in self.wins]
        if self.deep:
            d = self.deep
            for i, p in enumerate(d["plan"]):
                if p["win"] is None and now >= p["t"]:
                    r, c, h, w, side = p["pos"]
                    self.reserved.remove((r, c, h, w))
                    p["win"] = self.add_win(p["kind"], r, c, h, w, now, life=p["life"], level=i)
                    if i and d["plan"][i - 1]["win"]:
                        self.connect(d["plan"][i - 1]["win"], p["win"], side, now, handshake=False, deep=True)
            if now > d["end"] + 1:
                self.deep, self.reserved, self.deep_cool = None, [], now + 20
        for w in list(self.wins):
            if w.chain_at and now >= w.chain_at:
                w.chain_at = None
                if now < w.run_end - 2:
                    self.chain(w, now)
        for g in self.cap:
            if now >= self.next_spawn[g]:
                self.next_spawn[g] = now + random.uniform(0.5, 2.2)
                if sum(1 for w in self.wins if w.group == g) < self.cap[g]:
                    self.spawn(g, now)

        if not self.args.no_glitch:
            self.glitch = [(k, r, c, h, w, f - 1) for k, r, c, h, w, f in self.glitch if f > 1]
            if now >= self.next_glitch:
                self.add_glitches()
                g = self.args.glitch_every
                self.next_glitch = now + random.uniform(g * 0.5, g * 1.5)

    def add_glitches(self):
        for _ in range(random.randint(1, 4)):
            k, f = random.random(), random.randint(2, 6)
            if k < 0.55:
                a = random.randrange(self.h)
                self.glitch.append(("tear", a, 0, random.randint(1, 3),
                                    random.choice((-6, -5, -4, -3, -2, -1, 1, 2, 3, 4, 5, 6)), f))
            elif k < 0.85:
                self.glitch.append(("block", random.randrange(self.h), random.randrange(self.w),
                                    random.randint(1, 3), random.randint(6, 24), f))
            else:
                self.glitch.append(("flash", random.randrange(self.h), 0, 1, 0, min(f, 3)))

    # ---- drawing

    def render(self, now):
        cv = Canvas(self.h, self.w)
        tok, br, scr = self.tok, self.br, self.scr
        for r in range(self.R):
            for c in range(self.C):
                v = br[r][c]
                if scr[r][c]:
                    s, t = BG_SCR, rs()
                else:
                    s = BG_HEAD if v > 0.96 else PALETTE[int(v * (LEVELS - 1))]
                    t = tok[r][c]
                x = self.ox + c * 3
                cv.ch[r][x], cv.ch[r][x + 1] = t[0], t[1]
                cv.st[r][x] = cv.st[r][x + 1] = s
        for l in self.links:
            l.draw(cv, now)
        for win in self.wins:
            win.draw(cv, now)
        for kind, r, c, h, w, _ in self.glitch:
            rows = range(r, min(self.h, r + h))
            if kind == "tear":
                for rr in rows:
                    cv.ch[rr] = cv.ch[rr][-w:] + cv.ch[rr][:-w]
                    cv.st[rr] = cv.st[rr][-w:] + cv.st[rr][:-w]
                    s0 = random.randrange(self.w)
                    gs = random.choice(GLITCH_STYLES)
                    for cc in range(s0, min(self.w, s0 + random.randint(10, 40))):
                        if cv.ch[rr][cc] != " ":
                            cv.st[rr][cc] = gs
            elif kind == "block":
                gs = random.choice(GLITCH_STYLES)
                for rr in rows:
                    for cc in range(c, min(self.w, c + w)):
                        cv.put(rr, cc, random.choice("█▓▒░" + HEX * 2), gs)
            else:
                fs = random.choice(FLASH_STYLES)
                for rr in rows:
                    for cc in range(self.w):
                        if cv.ch[rr][cc] != " ":
                            cv.st[rr][cc] = fs
        out = ["\x1b[?2026h"]
        for r in range(self.h):
            parts = ["\x1b[%d;1H" % (r + 1)]
            prev = None
            for ch, s in zip(cv.ch[r], cv.st[r]):
                if s is not prev:
                    parts.append(s)
                    prev = s
                parts.append(ch)
            parts.append(RESET)
            out.append("".join(parts))
        out.append("\x1b[?2026l")
        return "".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--fps", type=int, default=30)
    ap.add_argument("--speed", type=float, default=1.0, help="rain speed multiplier")
    ap.add_argument("--max-hack", type=int, help="max decorative windows (default scales with area, up to 20)")
    ap.add_argument("--max-widgets", type=int, help="max system widgets (default scales with area, up to 12)")
    ap.add_argument("--no-hack", action="store_true", help="no decorative windows")
    ap.add_argument("--no-widgets", action="store_true", help="no system widgets")
    ap.add_argument("--min-life", type=float, default=5.0)
    ap.add_argument("--max-life", type=float, default=27.0)
    ap.add_argument("--no-glitch", action="store_true")
    ap.add_argument("--glitch-every", type=float, default=3.0, help="average seconds between glitch bursts")
    ap.add_argument("--deep-odds", type=int, default=250, help="1-in-N chance per spawned window of a deep-search chain")
    ap.add_argument("--deep-length", type=float, default=200.0, help="deep-search chain duration, seconds")
    ap.add_argument("--duration", type=float, help="exit after N seconds")
    args = ap.parse_args()

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[2J")
    try:
        tty.setcbreak(fd)
        size = tuple(shutil.get_terminal_size())
        scene = Scene(*size, args)
        frame = 1.0 / args.fps
        last = start = time.monotonic()
        while not stop:
            now = time.monotonic()
            if args.duration and now - start > args.duration:
                break
            cur = tuple(shutil.get_terminal_size())
            if cur != size:
                size = cur
                scene = Scene(*size, args)
                sys.stdout.write("\x1b[2J")
            scene.step(min(now - last, 0.1), now)
            last = now
            sys.stdout.write(scene.render(now))
            sys.stdout.flush()
            wait = frame - (time.monotonic() - now)
            if select.select([sys.stdin], [], [], max(0, wait))[0]:
                if os.read(fd, 16)[:1] in (b"q", b"Q", b"\x1b", b"\x03"):
                    break
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write(RESET + "\x1b[?7h\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
