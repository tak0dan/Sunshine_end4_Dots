class BreachC:
    title = "BREACH PROTOCOL"
    min_size = (22, 10)
    max_size = (36, 15)

    def __init__(self, ih, iw):
        self.cols = max(2, min(8, iw // 3))
        self.rows = max(2, min(7, ih - 3))
        self.ox = (iw - self.cols * 3) // 2
        self.grid = [[rt() for _ in range(self.cols)] for _ in range(self.rows)]
        n = random.randint(3, 5)
        axis = random.choice(("row", "col"))
        r, c = random.randrange(self.rows), random.randrange(self.cols)
        self.steps = []
        for _ in range(n):
            if axis == "row":
                nc = random.choice([x for x in range(self.cols) if x != c])
                self.steps.append(("row", r, random.choice((0, self.cols - 1)), nc))
                c, axis = nc, "col"
            else:
                nr = random.choice([x for x in range(self.rows) if x != r])
                self.steps.append(("col", c, random.choice((0, self.rows - 1)), nr))
                r, axis = nr, "row"
        self.step_t = random.uniform(0.5, 0.8)
        self.duration = n * self.step_t + 1.4

    def cell(self, k):
        ax, fx, _, tg = self.steps[k]
        return (fx, tg) if ax == "row" else (tg, fx)

    def draw(self, b, t):
        i = int(t / self.step_t)
        n = len(self.steps)
        locked = [self.cell(k) for k in range(min(i, n))]
        guide = cursor = None
        if i < n:
            ax, fx, start, tg = self.steps[i]
            p = min(1.0, (t / self.step_t - i) / 0.7)
            p = 1 - (1 - p) ** 2
            pos = int(round(start + (tg - start) * p))
            guide = (ax, fx)
            cursor = (fx, pos) if ax == "row" else (pos, fx)
        done = i >= n
        b.put(0, 1, "BUFFER", W_YD)
        for k, (r, c) in enumerate(locked):
            b.put(0, 8 + k * 5, "[%s]" % self.grid[r][c], W_C)
        for r in range(self.rows):
            for c in range(self.cols):
                if (r, c) == cursor:
                    s, tx = W_INV, rs()
                elif (r, c) in locked:
                    s = W_INV if done and blink(t, 6) else W_CINV
                    tx = self.grid[r][c]
                elif guide and ((guide[0] == "row" and guide[1] == r) or (guide[0] == "col" and guide[1] == c)):
                    s, tx = W_GUIDE, self.grid[r][c]
                else:
                    s, tx = W_Y, self.grid[r][c]
                b.put(2 + r, self.ox + c * 3, tx + " ", s)
        if done and blink(t):
            b.put(b.h - 1, 1, "BREACH SUCCESSFUL", W_C)


QUICKHACKS = ["CONTAGION", "SHORT CIRCUIT", "REBOOT OPTICS", "OVERHEAT", "SYSTEM RESET",
              "MEMORY WIPE", "CYBERPSYCHOSIS", "SONIC SHOCK", "BLINDING LIGHT", "WHISTLE"]


class UploadC:
    title = "QUICKHACK UPLOAD"
    min_size = (30, 8)
    max_size = (54, 12)

    def __init__(self, ih, iw):
        self.name = random.choice(QUICKHACKS)
        self.dur = random.uniform(4, 7)
        self.duration = self.dur + 1.5
        k = random.randint(4, 8)
        ts = sorted(random.random() for _ in range(k - 1))
        ps = sorted(random.random() for _ in range(k - 1))
        self.knots = list(zip([0] + ts + [1], [0] + ps + [1]))
        self.seed = random.randrange(1 << 30)

    def prog(self, t):
        x = min(1.0, t / self.dur)
        for (t0, p0), (t1, p1) in zip(self.knots, self.knots[1:]):
            if x <= t1:
                u = (x - t0) / max(1e-6, t1 - t0)
                return p0 + (p1 - p0) * u * u * (3 - 2 * u)
        return 1.0

    def draw(self, b, t):
        p = self.prog(t)
        bw = b.w - 8
        fill = int(p * bw)
        b.put(0, 1, "UPLOADING", W_YD)
        b.put(0, 11, self.name, W_YB)
        b.put(2, 1, "█" * fill, W_Y)
        b.put(2, 1 + fill, "░" * (bw - fill), W_YD)
        b.put(2, bw + 2, "%3d%%" % int(p * 100), W_C)
        for r in range(4, b.h - 1):
            rng = random.Random(self.seed + int(t * 10) * 31 + r)
            line = " ".join(rng.choice(CODES) for _ in range((b.w - 2) // 3))
            b.put(r, 1, line, W_YD)
        if p >= 1:
            if blink(t):
                b.put(b.h - 1, 1, "UPLOAD COMPLETE", W_C)
        else:
            b.put(b.h - 1, 1, "PACKETS %05d" % int(p * 40960), W_YD)


DAEMONS = ["DATAMINE_V1", "DATAMINE_V2", "ICEPICK", "MASS VULNERABILITY", "CAMERA SHUTDOWN",
           "FRIENDLY TURRETS", "NEUTRALIZE MALWARE", "OPTICS JAMMER", "WEAPONS JAMMER", "RESET ICE"]


class DaemonC:
    title = "DAEMONS"
    min_size = (30, 8)
    max_size = (44, 13)

    def __init__(self, ih, iw):
        n = max(2, min(ih - 1, 6))
        self.names = random.sample(DAEMONS, n)
        order = list(range(n))
        random.shuffle(order)
        self.t0 = [0.0] * n
        for rank, i in enumerate(order):
            self.t0[i] = 0.3 + rank * random.uniform(0.5, 1.0)
        self.ln = [random.uniform(0.7, 1.5) for _ in range(n)]
        self.fail = [random.random() < 0.15 for _ in range(n)]
        self.duration = max(a + b for a, b in zip(self.t0, self.ln)) + 1.3

    def draw(self, b, t):
        for i, name in enumerate(self.names):
            t0, ln = self.t0[i], self.ln[i]
            if t < t0:
                b.put(i, 1, "▒" * len(name), W_YD)
            elif t < t0 + ln:
                k = int((t - t0) / ln * len(name))
                txt = name[:k] + "".join(random.choice(HEX) if x != " " else " " for x in name[k:])
                b.put(i, 1, txt, W_C)
                b.put(i, b.w - 7, "[....]", W_CD)
            else:
                b.put(i, 1, name, W_R if self.fail[i] else W_YB)
                b.put(i, b.w - 7, "[FAIL]" if self.fail[i] else "[ OK ]", W_R if self.fail[i] else W_C)


class HexC:
    title = "MEMORY SCAN"
    min_size = (30, 8)
    max_size = (58, 16)

    def __init__(self, ih, iw):
        self.n = max(2, min(8, (iw - 10) // 4))
        self.seed = random.randrange(1 << 30)
        self.speed = random.uniform(6, 14)
        self.duration = random.uniform(5, 8)
        self.base = random.randrange(0x10000, 0xF0000, 8)

    def row(self, idx):
        rng = random.Random(self.seed + idx)
        return [rng.choice(CODES) if rng.random() < 0.6 else "%02X" % rng.randrange(256) for _ in range(self.n)]

    def draw(self, b, t):
        top = int(t * self.speed)
        rows = b.h - 1
        scan = int(t * 4) % rows
        scol = int(t * 9) % self.n
        rng = random.Random(int(t * 10))
        hot = {(rng.randrange(rows), rng.randrange(self.n)) for _ in range(3)}
        for rr in range(rows):
            data = self.row(top + rr)
            addr = "%06X" % (self.base + (top + rr) * self.n)
            rowsty = W_GUIDE if rr == scan else W_YD
            b.put(rr, 1, addr + "  ", W_Y if rr == scan else W_YD)
            x = 9
            for k, v in enumerate(data):
                s = W_INV if (rr == scan and k == scol) else W_C if (rr, k) in hot else rowsty
                b.put(rr, x, v + " ", s)
                x += 3
            asc = "".join(chr(33 + int(v, 16) % 90) for v in data)
            b.put(rr, x + 1, asc, rowsty)
        pct = min(100, int(t / self.duration * 100))
        b.put(b.h - 1, 1, "SCANNING 0x%06X  %3d%%" % (self.base + top * self.n, pct), W_C)


class CrackC:
    title = "ICE BREAKER"
    min_size = (30, 9)
    max_size = (46, 12)

    def __init__(self, ih, iw):
        self.n = max(6, min(16, iw - 14))
        self.total = random.uniform(5, 8)
        self.ok = random.random() < 0.78
        self.key = [random.choice(HEX) for _ in range(self.n)]
        self.lock = [random.uniform(0.8, self.total * 0.85) for _ in range(self.n)]
        if not self.ok:
            self.lock[random.randrange(self.n)] = math.inf
        self.end = max(self.lock) if self.ok else self.total
        self.duration = self.end + 1.6

    def draw(self, b, t):
        te = min(t, self.end)
        failed = not self.ok and t >= self.total
        b.put(0, 1, "ACCESS KEY", W_YD)
        b.put(2, 1, "[", W_YD)
        for k in range(self.n):
            if t >= self.lock[k]:
                b.put(2, 2 + k * 2, self.key[k], W_YB)
            else:
                b.put(2, 2 + k * 2, random.choice(HEX), W_R if failed else W_C)
        b.put(2, 2 + self.n * 2, "]", W_YD)
        frac = max(0.0, 1 - te / self.total)
        bw = b.w - 14
        fill = int(frac * bw)
        low = frac < 0.35
        s = W_R if low and blink(t, 5) else W_Y
        b.put(4, 1, "TRACE", W_YD)
        b.put(4, 7, "█" * fill, s)
        b.put(4, 7 + fill, "░" * (bw - fill), W_YD)
        b.put(4, bw + 8, "%4.1fs" % (self.total - te), W_R if low else W_Y)
        if t >= self.end and blink(t):
            if self.ok:
                b.put(b.h - 1, 1, "ACCESS GRANTED", W_C)
            else:
                b.put(b.h - 1, 1, "ACCESS DENIED", W_R)


class PingC:
    """Netrunner ping: expanding rings reveal devices that then fade."""
    title = "PING NETWORK"
    min_size = (30, 10)
    max_size = (52, 18)

    def __init__(self, ih, iw):
        self.h, self.w = ih - 1, iw
        self.cy, self.cx = (self.h - 1) / 2, (iw - 1) / 2
        self.speed = random.uniform(7, 11)
        self.maxd = math.hypot(self.cx / 2, self.cy) + 1
        self.loop = self.maxd + 3
        self.blips = []
        for _ in range(random.randint(5, 9)):
            r, c = random.randrange(self.h), random.randrange(max(1, iw - 5))
            self.blips.append((r, c, self.dist(r, c), rt()))
        self.duration = self.loop / self.speed * random.randint(2, 3) + 1

    def dist(self, r, c):
        return math.hypot((c - self.cx) / 2, r - self.cy)

    def draw(self, b, t):
        total = t * self.speed
        rr = total % self.loop
        for r in range(self.h):
            for c in range(self.w):
                d = self.dist(r, c)
                e = abs(d - rr)
                if e < 0.55:
                    b.put(r, c, "•" if e < 0.3 else "·", W_C)
                elif abs(d - round(d / 4) * 4) < 0.22:
                    b.put(r, c, "·", W_YD)
        b.put(int(self.cy), int(self.cx), "╋", W_C)
        seen = 0
        for r, c, d, tok in self.blips:
            if total < d:
                continue
            seen += 1
            age = ((total - d) % self.loop) / self.speed
            if age < 0.4:
                b.put(r, c, "◆", W_CINV)
                b.put(r, c + 2, tok, W_CINV)
            elif age < 2.5:
                b.put(r, c, "◆", W_C)
                b.put(r, c + 2, tok, W_C)
            else:
                b.put(r, c, "◇", W_YD)
        b.put(b.h - 1, 1, "DEVICES %d/%d   SWEEP %d" % (seen, len(self.blips), int(total / self.loop) + 1), W_YB)


class WaveC:
    """Signal intercept: noisy trace tunes into a clean locked waveform."""
    title = "SIGNAL INTERCEPT"
    min_size = (30, 9)
    max_size = (56, 16)

    def __init__(self, ih, iw):
        self.shape = random.choice(("sin", "sq", "saw", "mix"))
        self.freq = random.uniform(0.25, 0.6)
        self.speed = random.uniform(3, 7)
        self.target = random.uniform(88, 990)
        self.t_noise = random.uniform(1.5, 2.5)
        self.t_tune = random.uniform(2.0, 3.0)
        self.duration = self.t_noise + self.t_tune + 2.5

    def wave(self, x, t):
        u = x * self.freq - t * self.speed
        s = math.sin(u)
        if self.shape == "sq":
            return 1.0 if s >= 0 else -1.0
        if self.shape == "saw":
            return (u / math.pi) % 2 - 1
        if self.shape == "mix":
            return 0.6 * s + 0.4 * math.sin(2.7 * u)
        return s

    def draw(self, b, t):
        rows = b.h - 2
        mid = 1 + rows // 2
        half = (rows - 1) / 2
        nl = 1.0 if t < self.t_noise else max(0.0, 1 - (t - self.t_noise) / self.t_tune)
        locked = t >= self.t_noise + self.t_tune
        for x in range(1, b.w - 1, 2):
            b.put(mid, x, "·", W_YD)
        sty = W_C if locked else W_R if nl > 0.7 else W_Y
        prev = None
        for x in range(1, b.w - 1):
            a = max(-1.0, min(1.0, self.wave(x, t) + random.uniform(-1, 1) * nl * 1.3))
            row = int(round(mid - a * half))
            if prev is not None:
                for y in range(min(prev, row) + 1, max(prev, row)):
                    b.put(y, x, "│", sty)
            b.put(row, x, "█" if abs(row - (prev if prev is not None else row)) < 2 else "▒", sty)
            prev = row
        shown = self.target * (1 - nl) + random.uniform(80, 1000) * nl
        b.put(0, 1, "FREQ %6.1f MHz" % shown, W_C if locked else W_YB)
        if locked:
            if blink(t):
                b.put(b.h - 1, 1, "SIGNAL LOCKED", W_C)
        else:
            b.put(b.h - 1, 1, "SCANNING..." if nl > 0.7 else "TUNING...", W_YD)


class TargetC:
    """Targeting reticle: sweep, then brackets converge on a lock."""
    title = "TARGET ACQUISITION"
    min_size = (32, 11)
    max_size = (54, 18)

    def __init__(self, ih, iw):
        self.h, self.w = ih - 1, iw
        self.tr = random.randint(2, max(2, self.h - 3))
        self.tc = random.randint(7, max(7, iw - 8))
        self.vert = random.random() < 0.5
        self.sweeps = random.randint(1, 3)
        self.sw_t = random.uniform(0.9, 1.5)
        self.t_conv = random.uniform(1.0, 1.6)
        self.dist = random.uniform(5, 95)
        self.duration = self.sweeps * self.sw_t + self.t_conv + 2.5

    def draw(self, b, t):
        h, w = self.h, self.w
        for r in range(0, h, 2):
            for c in range(1, w, 4):
                b.put(r, c, "·", W_YD)
        t_sweep = self.sweeps * self.sw_t
        if t < t_sweep:
            p = (t % self.sw_t) / self.sw_t
            if self.vert:
                x = int(p * (w - 1))
                for k in range(4):
                    for r in range(h):
                        b.put(r, x - k, "│" if k == 0 else "░", W_C if k == 0 else W_CD)
            else:
                y = int(p * (h - 1))
                for k in range(3):
                    b.put(y - k, 0, ("─" if k == 0 else "░") * w, W_C if k == 0 else W_CD)
            b.put(b.h - 1, 1, "SCANNING SECTOR %d" % (int(t / self.sw_t) + 1), W_YD)
            return
        q = min(1.0, (t - t_sweep) / self.t_conv)
        q = 1 - (1 - q) ** 3
        top = int(0 + (self.tr - 1) * q)
        bot = int((h - 1) + (self.tr + 1 - (h - 1)) * q)
        left = int(0 + (self.tc - 6) * q)
        right = int((w - 1) + (self.tc + 6 - (w - 1)) * q)
        for (r, c, ch, dr, dc) in ((top, left, "┌", 1, 1), (top, right, "┐", 1, -1),
                                   (bot, left, "└", -1, 1), (bot, right, "┘", -1, -1)):
            b.put(r, c, ch, W_C)
            b.put(r, c + dc, "─", W_C)
            b.put(r, c + 2 * dc, "─", W_C)
            b.put(r + dr, c, "│", W_C)
        if q >= 1:
            for c in range(w):
                if abs(c - self.tc) > 1:
                    b.put(self.tr, c, "─", W_CD)
            for r in range(h):
                if abs(r - self.tr) > 0:
                    b.put(r, self.tc, "│", W_CD)
            b.put(self.tr, self.tc, "◎" if blink(t, 4) else "◉", W_R)
            if blink(t):
                b.put(b.h - 1, 1, "TARGET LOCKED  D %.1fm" % self.dist, W_R)
        else:
            b.put(b.h - 1, 1, "ACQUIRING...", W_YD)


class HandshakeC:
    """Spawned by every connected pair of windows: relay nodes light up."""
    title = "NETWORK HANDSHAKE"
    min_size = (36, 11)
    max_size = (48, 15)

    def __init__(self, ih, iw):
        self.h, self.w = ih, iw
        n = random.randint(2, 4)
        self.xs = [2 + i * (iw - 5) // (n + 1) for i in range(n + 2)]
        self.ys = [random.randint(2, max(2, ih - 3)) for _ in range(n + 2)]
        self.ids = [rs() + rs() for _ in range(n + 2)]
        self.names = ["LOCAL"] + ["RELAY"] * n + ["TARGET"]
        self.path = []
        for i in range(n + 1):
            x0, y0, x1, y1 = self.xs[i], self.ys[i], self.xs[i + 1], self.ys[i + 1]
            for x in range(x0 + 1, x1):
                self.path.append((round(y0 + (y1 - y0) * (x - x0) / (x1 - x0)), x))
        self.node_t = random.uniform(0.35, 0.55)
        self.t_pk = self.node_t * (n + 2) + 0.3
        self.pk_speed = random.uniform(30, 45)
        self.pk_dur = len(self.path) / self.pk_speed
        self.ok = random.random() < 0.85
        self.duration = self.t_pk + self.pk_dur * 2 + 2.4

    def draw(self, b, t):
        n = len(self.xs)
        shown = min(n, int(t / self.node_t) + 1)
        if t < self.t_pk:
            lit_to = 0
            pk = None
        else:
            u = t - self.t_pk
            lit_to = int(min(1.0, u / self.pk_dur) * len(self.path))
            pk = int((u % self.pk_dur) * self.pk_speed) if u < self.pk_dur * 2 else None
        done = t >= self.t_pk + self.pk_dur * 2
        seg = len(self.path) // max(1, n - 1)
        for i, (r, c) in enumerate(self.path):
            if i // max(1, seg) >= shown - 1 and t < self.t_pk:
                continue
            if i < lit_to:
                bad = not self.ok and done and i >= len(self.path) - seg
                b.put(r, c, "━", W_R if bad else W_C if done else W_Y)
            else:
                b.put(r, c, "·", W_YD)
        if pk is not None and pk < len(self.path):
            r, c = self.path[pk]
            b.put(r, c, "◆", W_C)
        for i in range(shown):
            x, y = self.xs[i], self.ys[i]
            b.put(y, x, "◉", W_C if done else W_YB)
            b.put(y - 1, x - 2, self.ids[i], W_YD)
            if i in (0, n - 1):
                b.put(y + 1, x - 2, self.names[i], W_YD)
        if done and blink(t):
            b.put(b.h - 1, 1, "LINK ESTABLISHED" if self.ok else "LINK REFUSED", W_C if self.ok else W_R)
        elif not done and t >= self.t_pk:
            b.put(b.h - 1, 1, "HANDSHAKE...", W_YD)
        else:
            b.put(b.h - 1, 1, "PROBING NODES %d/%d" % (shown, n), W_YD)


