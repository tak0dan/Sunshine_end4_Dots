diff --git a/dots/.config/hypr/scripts/KeyboardLayout.sh b/dots/.config/hypr/scripts/KeyboardLayout.sh
new file mode 100755
index 00000000..0d29bf41
--- /dev/null
+++ b/dots/.config/hypr/scripts/KeyboardLayout.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# ==================================================
+#  Sunshine Hyprland Dots (2026)
+#  Project URL: https://github.com/tak0dan/Sunshine_Hyprland_Dots
+#  License: GNU GPLv3
+#  SPDX-License-Identifier: GPL-3.0-or-later
+# ==================================================
+# This is for changing kb_layouts. Set kb_layouts in "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/UserConfigs/user_settings.lua"
+
+notif_icon="${XDG_CONFIG_HOME:-$HOME/.config}/swaync/images/ja.png"
+SCRIPTSDIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts"
+
+# Refined ignore list with patterns or specific device names
+ignore_patterns=(
+  "--(avrcp)"
+  "Bluetooth Speaker"
+  "Other Device 
+  Name"
+)
+
+# Function to get keyboard names
+get_keyboard_names() {
+  hyprctl devices -j | jq -r '.keyboards[].name'
+}
+
+# Function to check if a device matches any ignore pattern
+is_ignored() {
+  local device_name=$1
+  for pattern in "${ignore_patterns[@]}"; do
+    if [[ "$device_name" == *"$pattern"* ]]; then
+      return 0 # Device matches ignore pattern
+    fi
+  done
+  return 1 # Device does not match any ignore pattern
+}
+
+# Function to get current layout info
+# Stores values in layout_mapping, variant_mapping and layout_index
+get_current_layout_info() {
+  local found_kb=false
+
+  # Read from the first non-ignored layout
+  while read -r name; do
+    if ! is_ignored "$name"; then
+      found_kb=true
+      local layout_mapping_str=$(hyprctl devices -j |
+        jq -r --arg name "$name" '.keyboards[] | select(.name==$name).layout')
+      IFS="," read -r -a layout_mapping <<<"$layout_mapping_str"
+
+      local variant_mapping_str=$(hyprctl devices -j |
+        jq -r --arg name "$name" '.keyboards[] | select(.name==$name).variant')
+      IFS="," read -r -a variant_mapping <<<"$variant_mapping_str"
+
+      layout_index=$(hyprctl devices -j |
+        jq -r --arg name "$name" '.keyboards[] | select(.name==$name).active_layout_index')
+      break
+    fi
+  done <<< "$(get_keyboard_names)"
+
+  $found_kb && return 0
+  return 1
+}
+
+# Function to change keyboard layout
+change_layout() {
+  local error_found=false
+
+  while read -r name; do
+    if is_ignored "$name"; then
+      echo "Skipping ignored device: $name"
+      continue
+    fi
+
+    echo "Switching layout for $name to $new_layout..."
+    hyprctl switchxkblayout "$name" "$next_index"
+    if [ $? -ne 0 ]; then
+      echo "Error while switching layout for $name." >&2
+      error_found=true
+    fi
+  done <<<"$(get_keyboard_names)"
+
+  $error_found && return 1
+  return 0
+}
+
+
+# Stores values in layout_mapping, variant_mapping and layout_index
+if ! get_current_layout_info; then
+  echo "Could not get current layout information." >&2
+  echo "There might not be any keyboards available, \
+    or some were unnecessarily set as ignored." >&2
+  notify-send -u low -t 2000 'kb_layout' " Error:" " Layout change failed"
+  echo "Exiting $0 $*" >&2
+  exit 1
+fi
+
+current_layout=${layout_mapping[$layout_index]}
+current_variant=${variant_mapping[$layout_index]}
+
+if [[ "$1" == "status" ]]; then
+  echo "$current_layout${current_variant:+($current_variant)}"
+elif [[ "$1" == "switch" ]]; then
+  echo "Current layout: $current_layout($current_variant)"
+
+  layout_count=${#layout_mapping[@]}
+  echo "Number of layouts: $layout_count"
+
+  next_index=$(( (layout_index + 1) % layout_count ))
+  new_layout="${layout_mapping[$next_index]}"
+  new_variant="${variant_mapping[$next_index]}"
+  echo "Next layout: $new_layout"
+
+  # Execute layout change and notify
+  if ! change_layout; then
+    notify-send -u low -t 2000 'kb_layout' " Error:" " Layout change failed"
+    echo "Layout change failed." >&2
+    exit 1
+  else
+    notify-send -u low -i "$notif_icon" " kb_layout: $new_layout${new_variant:+($new_variant)}"
+    echo "Layout change notification sent."
+  fi
+else
+  echo "Usage: $0 {status|switch}"
+fi
diff --git a/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.py b/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.py
new file mode 100755
index 00000000..8d7e54ae
--- /dev/null
+++ b/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.py
@@ -0,0 +1,636 @@
+#!/usr/bin/env python3
+# ==================================================
+#  Sunshine Hyprland Dots (2026)
+#  Project URL: https://github.com/tak0dan/Sunshine_Hyprland_Dots
+#  License: GNU GPLv3
+#  SPDX-License-Identifier: GPL-3.0-or-later
+# ==================================================
+"""
+TAK_0'S Per-Window-Switch (python edition)
+
+Remembers the keyboard layout of every window and restores it when that
+window gets focused again.
+
+The shell version forks hyprctl + jq for every event and for every
+keyboard device, which makes switching visibly laggy. This one talks to
+Hyprland's IPC sockets directly and keeps devices, layouts and the
+window map in memory, so a focus change costs ~1ms instead of ~150ms.
+It also exposes a control socket, so the toggle keybind is a single
+socat round trip to the already running daemon.
+
+CLI (same interface as the shell version):
+  --listener        run the daemon (systemd user service runs this)
+  toggle (default)  advance the layout of the focused window
+  status            print the layout stored for the focused window
+  counts            print how many windows use each layout + the preferred one
+
+New windows start with the preferred layout of their window type (class):
+the one used on the most windows of that class, provided it leads the
+runner-up by at least PREFERRED_MARGIN (15%). A class without such a clear
+winner falls back to the same rule applied to all windows, and finally to
+the first configured layout.
+
+The layout list may change at any time (one layout, two, a swapped
+language, ...). Windows keep the layout name they were given and it is only
+resolved against the current list when used, so nothing is forgotten:
+  - a language that was removed is replaced by the one that took its place
+    (es -> de), until it is configured again, when its windows get it back;
+  - a language that has no replacement falls back to the first layout.
+"""
+
+import errno
+import json
+import os
+import select
+import socket
+import subprocess
+import sys
+
+MAP_FILE = os.path.join(
+    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
+    "kb_layout_per_window",
+)
+STATE_FILE = MAP_FILE + ".json"   # last seen layout list + replacements
+RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
+CTL_PATH = os.path.join(RUNTIME_DIR, "tak0-per-window-switch.sock")
+# A layout becomes the preferred one when its window count is at least this
+# much (relative) above every other layout's count.
+PREFERRED_MARGIN = 0.15
+
+
+def log(*args):
+    print(*args, file=sys.stderr)
+
+
+# ---------------------------------------------------------------- IPC client
+
+
+class Hypr:
+    """Minimal Hyprland IPC client (command socket + event socket)."""
+
+    def __init__(self):
+        self.cmd_path, self.evt_path = self._find_sockets()
+
+    @staticmethod
+    def _find_sockets():
+        base = os.path.join(RUNTIME_DIR, "hypr")
+        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
+        candidates = ([sig] if sig else []) + sorted(
+            os.listdir(base) if os.path.isdir(base) else [], reverse=True
+        )
+        for entry in candidates:
+            cmd = os.path.join(base, entry, ".socket.sock")
+            if os.path.exists(cmd):
+                return cmd, os.path.join(base, entry, ".socket2.sock")
+        raise SystemExit("Error: Hyprland socket not found.")
+
+    def cmd(self, command):
+        """Send one IPC command, return the raw reply."""
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
+            sock.settimeout(2.0)
+            sock.connect(self.cmd_path)
+            sock.sendall(command.encode())
+            chunks = []
+            while True:
+                chunk = sock.recv(65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+        return b"".join(chunks).decode(errors="replace")
+
+    def jcmd(self, command):
+        try:
+            raw = self.cmd(command)
+            return json.loads(raw) if raw else None
+        except (OSError, ValueError):
+            return None
+
+
+# ---------------------------------------------------------------- state
+
+
+class State:
+    """Everything the switcher needs, cached in memory."""
+
+    def __init__(self):
+        self.hypr = Hypr()
+        self.layouts = self._load_layouts()
+        self.devices = []          # keyboard names that have a layout
+        self.cur_idx = 0           # layout index currently in effect
+        self.last_focus = None     # window address ("0x...")
+        self.maps = {}             # window address -> layout name
+        self.classes = {}          # window address -> window class
+        self.dirty = True          # devices/cur_idx need a resync
+        self.aliases = {}          # removed layout -> layout that replaced it
+        self._load_map()
+        self._load_state()
+
+    # ---- layout / device info
+
+    def _load_layouts(self):
+        option = self.hypr.jcmd("j/getoption input:kb_layout") or {}
+        raw = (option.get("str") or "").strip()
+        if not raw:
+            devices = self.hypr.jcmd("j/devices") or {}
+            raw = next(
+                (
+                    kb.get("layout")
+                    for kb in devices.get("keyboards", [])
+                    if kb.get("layout")
+                ),
+                "",
+            )
+        return [lay for lay in raw.split(",") if lay] or ["us"]
+
+    # ---- layout list changes
+
+    def _load_state(self):
+        saved = []
+        try:
+            with open(STATE_FILE, "r", encoding="utf-8") as handle:
+                data = json.load(handle)
+            saved = [l for l in data.get("layouts", []) if isinstance(l, str)]
+            self.aliases = {
+                k: v for k, v in data.get("aliases", {}).items() if isinstance(v, str)
+            }
+        except (OSError, ValueError, AttributeError):
+            pass
+        self.reconcile(saved)
+
+    def _save_state(self):
+        try:
+            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
+            tmp = STATE_FILE + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as handle:
+                json.dump({"layouts": self.layouts, "aliases": self.aliases}, handle)
+            os.replace(tmp, STATE_FILE)
+        except OSError:
+            pass
+
+    def reconcile(self, old):
+        """Compare the previous layout list with the current one.
+
+        Layouts that vanished are paired, in order, with the ones that
+        appeared (es -> de). Unpaired ones just fall back to the default.
+        The windows' own data is never rewritten, so switching back works."""
+        if old != self.layouts:
+            removed = [l for l in dict.fromkeys(old) if l not in self.layouts]
+            added = [l for l in dict.fromkeys(self.layouts) if l not in old]
+            for name in added + removed:
+                self.aliases.pop(name, None)
+            if len(removed) == len(added):
+                self.aliases.update(zip(removed, added))
+            self._save_state()
+        return old != self.layouts
+
+    def resolve(self, name):
+        """Configured layout that `name` stands for now, or None."""
+        seen = set()
+        while name and name not in self.layouts and name not in seen:
+            seen.add(name)
+            name = self.aliases.get(name)
+        return name if name in self.layouts else None
+
+    def effective(self, name):
+        return self.resolve(name) or self.layouts[0]
+
+    def index_of(self, name):
+        try:
+            return self.layouts.index(name)
+        except ValueError:
+            return 0
+
+    def refresh_devices(self, devices=None):
+        devices = devices if devices is not None else (self.hypr.jcmd("j/devices") or {})
+        self.devices = [
+            kb["name"] for kb in devices.get("keyboards", []) if kb.get("layout")
+        ]
+        return devices
+
+    def sync(self, force=False):
+        """Refresh the device list and the layout index actually in effect."""
+        if not force and not self.dirty:
+            return
+        devices = self.refresh_devices()
+        keyboards = [
+            kb for kb in devices.get("keyboards", []) if kb.get("name") in self.devices
+        ]
+        # Prefer the primary keyboard: virtual devices (power/sleep buttons,
+        # video bus, ydotool) can drift out of sync with the keyboard you
+        # actually type on, and they are listed first.
+        primary = next((kb for kb in keyboards if kb.get("main")), None)
+        for kb in ([primary] if primary else []) + keyboards:
+            idx = kb.get("active_layout_index")
+            if isinstance(idx, int) and 0 <= idx < len(self.layouts):
+                self.cur_idx = idx
+                break
+        self.dirty = False
+
+    # ---- per-window map (same "0xADDR:layout" format as the shell version)
+
+    def _load_map(self):
+        try:
+            with open(MAP_FILE, "r", encoding="utf-8") as handle:
+                for line in handle:
+                    line = line.strip()
+                    if ":" in line:
+                        addr, lay = line.split(":", 1)
+                        self.maps[addr] = lay
+        except OSError:
+            pass
+
+    # ---- layout usage counter
+
+    def counts(self, cls=None):
+        """Windows per layout; only those of class `cls` unless it is None.
+
+        maps only holds open windows, so closed ones stop counting."""
+        counts = {lay: 0 for lay in self.layouts}
+        for addr, lay in self.maps.items():
+            lay = self.resolve(lay)
+            if lay and (cls is None or self.classes.get(addr) == cls):
+                counts[lay] += 1
+        return counts
+
+    def clear_winner(self, counts):
+        """The layout leading by PREFERRED_MARGIN, or None."""
+        ranked = sorted(counts.items(), key=lambda kv: -kv[1])
+        top, top_n = ranked[0]
+        runner_up = ranked[1][1] if len(ranked) > 1 else 0
+        if top_n > 0 and top_n >= runner_up * (1 + PREFERRED_MARGIN):
+            return top
+        return None
+
+    def preferred_layout(self, cls=None):
+        """Layout for a new window of class `cls`.
+
+        Per class first, then all windows, then the first layout."""
+        winner = cls and self.clear_winner(self.counts(cls))
+        return winner or self.clear_winner(self.counts()) or self.layouts[0]
+
+    def load_classes(self):
+        for client in self.hypr.jcmd("j/clients") or []:
+            if client.get("address"):
+                self.classes[client["address"]] = client.get("class") or ""
+
+    def class_of(self, addr):
+        if addr not in self.classes:
+            self.load_classes()
+        return self.classes.get(addr)
+
+    def prune_stale(self):
+        """Drop windows that closed while the daemon was not running."""
+        clients = self.hypr.jcmd("j/clients")
+        if clients is None:
+            return
+        live = {c.get("address") for c in clients}
+        stale = [a for a in self.maps if a not in live]
+        self.classes = {a: c for a, c in self.classes.items() if a in live}
+        for addr in stale:
+            del self.maps[addr]
+        if stale:
+            self._write_map()
+
+    def store(self, addr, lay):
+        if not addr or self.maps.get(addr) == lay:
+            return
+        self.maps[addr] = lay
+        self._write_map()
+
+    def prune(self, addr):
+        if self.maps.pop(addr, None) is not None:
+            self._write_map()
+
+    def _write_map(self):
+        os.makedirs(os.path.dirname(MAP_FILE), exist_ok=True)
+        tmp = MAP_FILE + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as handle:
+            for addr, lay in self.maps.items():
+                handle.write(f"{addr}:{lay}\n")
+        os.replace(tmp, MAP_FILE)
+
+    # ---- switching
+
+    def switch_device(self, name, idx):
+        """Switch one keyboard, tolerating Hyprland's IPC dialects.
+
+        Raw request first (that is what `hyprctl switchxkblayout` sends);
+        the older `dispatch ...` form is the legacy fallback.
+        """
+        for command in (
+            f"switchxkblayout {name} {idx}",
+            f"/switchxkblayout {name} {idx}",
+            f"dispatch switchxkblayout {name} {idx}",
+        ):
+            try:
+                reply = self.hypr.cmd(command)
+            except OSError:
+                continue
+            if not reply.startswith("error"):
+                return True
+        return False
+
+    def switch_to(self, idx):
+        if idx == self.cur_idx:
+            return
+        for name in self.devices:
+            # NOTE: `switchxkblayout all` only landed in newer Hyprland; on
+            # 0.56 it answers "ok" and does nothing, so every keyboard gets
+            # its own (cheap, in-process) request.
+            self.switch_device(name, idx)
+        self.cur_idx = idx
+
+    def focused_window(self):
+        info = self.hypr.jcmd("j/activewindow") or {}
+        return info.get("address")
+
+    def do_toggle(self):
+        """Advance the layout of the focused window and remember it."""
+        if len(self.layouts) < 2:
+            return "only one layout"
+        self.sync(force=True)
+        # With the session locked there is no focused window; the layout then
+        # belongs to the window that was focused before the lock.
+        addr = self.focused_window() or self.last_focus
+        nxt = (self.cur_idx + 1) % len(self.layouts)
+        self.switch_to(nxt)
+        # Ask Hyprland what is really in effect now instead of trusting the
+        # request: this way the notification (and the saved map) can never
+        # claim a layout that was not actually applied.
+        self.sync(force=True)
+        actual = self.layouts[self.cur_idx]
+        if addr:
+            self.store(addr, actual)
+        notify(actual)
+        return "ok"
+
+    def focused_layout(self):
+        stored = self.maps.get(self.focused_window() or "")
+        return self.effective(stored) if stored else self.layouts[self.cur_idx]
+
+    # ---- event handling
+
+    def on_focus(self, addr):
+        if addr == self.last_focus:
+            return
+        prev, self.last_focus = self.last_focus, addr
+        # Remember what the window we are leaving was using. This also
+        # captures layouts changed through the global switcher.
+        # A stored name that only stands for the current layout (a removed
+        # language that was replaced) is kept, so it is not forgotten.
+        if prev:
+            cur = self.layouts[self.cur_idx]
+            if prev not in self.maps or self.effective(self.maps[prev]) != cur:
+                self.store(prev, cur)
+        want = self.effective(self.maps[addr]) if addr in self.maps else None
+        if not want:
+            # First time we see this window: start it with the preferred
+            # layout. It is not counted yet, so it cannot vote for itself.
+            want = self.preferred_layout(self.class_of(addr))
+            self.store(addr, want)
+        self.switch_to(self.index_of(want))
+
+    def apply_batch(self, events):
+        focus = None
+        relayout = False
+        closed = []
+        for name, data in events:
+            if name == "activewindowv2":
+                data = data.strip()
+                if data and data != "empty":
+                    focus = data if data.startswith("0x") else "0x" + data
+            elif name == "openwindow":
+                # ADDRESS,WORKSPACE,CLASS,TITLE
+                fields = data.split(",", 3)
+                if len(fields) >= 3:
+                    self.classes["0x" + fields[0]] = fields[2]
+            elif name == "closewindow":
+                data = data.strip()
+                if data:
+                    closed.append(data if data.startswith("0x") else "0x" + data)
+            elif name == "activelayout":
+                _, _, lay = data.partition(",")
+                idx = self.layouts.index(lay) if lay in self.layouts else -1
+                if idx >= 0:
+                    self.cur_idx = idx
+                else:
+                    # A layout we have not seen yet (global switcher): the
+                    # next sync will pick the real index up.
+                    self.dirty = True
+            elif name in ("deviceadded", "deviceremoved"):
+                self.devices = []
+                self.dirty = True
+            elif name == "configreloaded":
+                old, self.layouts = self.layouts, self._load_layouts()
+                self.dirty = True
+                self.cur_idx = min(self.cur_idx, len(self.layouts) - 1)
+                relayout = self.reconcile(old)
+
+        for addr in closed:
+            self.prune(addr)
+            self.classes.pop(addr, None)
+        if self.dirty:
+            self.sync()
+        if focus:
+            self.on_focus(focus)
+        elif relayout and self.last_focus in self.maps:
+            # The layout list changed under the focused window: give it the
+            # layout it stands for now.
+            self.switch_to(self.index_of(self.effective(self.maps[self.last_focus])))
+
+
+# ---------------------------------------------------------------- notifications
+
+
+def pick_icon():
+    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
+    for path in (
+        os.path.join(config, "swaync", "icons", "keyboard.png"),
+        os.path.join(config, "swaync", "images", "ja.png"),
+        os.path.join(config, "swaync", "images", "note.png"),
+    ):
+        if os.path.exists(path):
+            return path
+    return ""
+
+
+def notify(layout):
+    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
+        return
+    subprocess.run(
+        [
+            "notify-send",
+            "-e",
+            "-h", "string:x-canonical-private-synchronous:kb_layout_notif",
+            "-h", "boolean:SWAYNC_BYPASS_DND:true",
+            "-u", "low",
+            "-i", pick_icon(),
+            " Keyboard Layout (Per-Window)",
+            f" {layout}",
+        ],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        check=False,
+    )
+
+
+# ---------------------------------------------------------------- control socket
+
+
+def ctl_send(request):
+    """Ask a running daemon to handle a request. None if no daemon answers."""
+    if not os.path.exists(CTL_PATH):
+        return None
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
+            sock.settimeout(2.0)
+            sock.connect(CTL_PATH)
+            sock.sendall(request.encode())
+            return sock.recv(4096).decode(errors="replace").strip()
+    except OSError:
+        return None
+
+
+def ctl_server():
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        server.bind(CTL_PATH)
+    except OSError as err:
+        if err.errno != errno.EADDRINUSE:
+            raise
+        # Stale socket from a dead daemon (or a duplicate instance).
+        if ctl_send("ping") == "pong":
+            raise SystemExit("Another instance is already running.")
+        os.unlink(CTL_PATH)
+        server.bind(CTL_PATH)
+    server.listen(4)
+    server.setblocking(False)
+    return server
+
+
+def format_counts(state):
+    def line(cls):
+        parts = [f"{lay}={n}" for lay, n in state.counts(cls).items()]
+        return f"{' '.join(parts)} preferred={state.preferred_layout(cls)}"
+
+    state.load_classes()
+    lines = [f"all: {line(None)}"]
+    for cls in sorted({c for a, c in state.classes.items() if a in state.maps and c}):
+        lines.append(f"{cls}: {line(cls)}")
+    return "\n".join(lines)
+
+
+def handle_ctl(state, server):
+    try:
+        conn, _ = server.accept()
+    except OSError:
+        return False
+    with conn:
+        conn.settimeout(1.0)
+        try:
+            request = conn.recv(256).decode(errors="replace").strip() or "toggle"
+        except OSError:
+            return False
+        if request == "ping":
+            reply = "pong"
+        elif request == "toggle":
+            reply = state.do_toggle()
+        elif request == "status":
+            reply = state.focused_layout()
+        elif request == "counts":
+            reply = format_counts(state)
+        else:
+            reply = f"unknown command: {request}"
+        try:
+            conn.sendall(reply.encode())
+        except OSError:
+            pass
+    return request == "quit"
+
+
+# ---------------------------------------------------------------- listener
+
+
+def run_listener():
+    state = State()
+    state.load_classes()
+    state.prune_stale()
+    state.sync(force=True)
+    state.last_focus = state.focused_window()
+
+    events = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    events.setblocking(False)
+    events.connect_ex(state.hypr.evt_path)
+
+    server = ctl_server()
+    buf = b""
+
+    while True:
+        ready, _, _ = select.select([events, server], [], [])
+        batch = []
+
+        if events in ready:
+            while True:
+                try:
+                    chunk = events.recv(65536)
+                except BlockingIOError:
+                    break
+                if not chunk:
+                    raise SystemExit  # Hyprland is gone; systemd restarts us
+                buf += chunk
+                lines = buf.split(b"\n")
+                buf = lines.pop()
+                for line in lines:
+                    name, _, data = line.decode(errors="replace").partition(">>")
+                    batch.append((name, data))
+                # Drain everything already queued so a burst of focus
+                # changes ends in a single switch.
+                if not select.select([events], [], [], 0)[0]:
+                    break
+
+        quit_requested = False
+        if server in ready:
+            quit_requested = handle_ctl(state, server)
+
+        if batch:
+            state.apply_batch(batch)
+        if quit_requested:
+            raise SystemExit
+
+
+# ---------------------------------------------------------------- CLI
+
+
+def main():
+    mode = sys.argv[1] if len(sys.argv) > 1 else "toggle"
+    if mode in ("--listener", "--daemon"):
+        run_listener()
+        return 0
+    if mode in ("toggle", "status", "counts"):
+        reply = ctl_send(mode)
+        if reply is None:
+            # No daemon running: do the work directly (same result, just
+            # without the per-window restore until the service is back).
+            state = State()
+            state.sync(force=True)
+            if mode == "toggle":
+                reply = state.do_toggle()
+            elif mode == "counts":
+                state.prune_stale()
+                reply = format_counts(state)
+            else:
+                reply = state.focused_layout()
+        print(reply)
+        return 0
+    if mode in ("-h", "--help"):
+        print(__doc__)
+        return 0
+    print(f"Usage: {os.path.basename(sys.argv[0])} [--listener|toggle|status|counts]", file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except KeyboardInterrupt:
+        sys.exit(0)
diff --git a/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.sh b/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.sh
new file mode 100755
index 00000000..df37270a
--- /dev/null
+++ b/dots/.config/hypr/scripts/Tak0-Per-Window-Switch.sh
@@ -0,0 +1,223 @@
+#!/usr/bin/env bash
+# ==================================================
+#  Sunshine Hyprland Dots (2026)
+#  Project URL: https://github.com/tak0dan/Sunshine_Hyprland_Dots
+#  License: GNU GPLv3
+#  SPDX-License-Identifier: GPL-3.0-or-later
+# ==================================================
+##################################################################
+#                                                                #
+#                  TAK_0'S Per-Window-Switch                     #
+#                                                                #
+#  Just a little script that I made to switch keyboard layouts   #
+#       per-window instead of global switching for the more      #
+#                 smooth and comfortable workflow.               #
+#                                                                #
+##################################################################
+
+set -uo pipefail
+
+MAP_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/kb_layout_per_window"
+notif="${XDG_CONFIG_HOME:-$HOME/.config}/swaync/images"
+icons_dir="${XDG_CONFIG_HOME:-$HOME/.config}/swaync/icons"
+SCRIPT_NAME="$(basename "$0")"
+SCRIPT_PATH="$(readlink -f "$0")"
+
+# Pick notification icon
+if [[ -f "$icons_dir/keyboard.png" ]]; then
+    ICON="$icons_dir/keyboard.png"
+elif [[ -f "$notif/ja.png" ]]; then
+    ICON="$notif/ja.png"
+else
+    ICON="$notif/note.png"
+fi
+
+# Ensure cache directory and map file exist
+mkdir -p "$(dirname "$MAP_FILE")"
+touch "$MAP_FILE"
+
+# Function to get layouts (queries live Hyprland option first, then config files)
+get_layouts() {
+    local layouts=""
+
+    # 1. Primary: Live option from active Hyprland session (fast, authoritative in both Lua & conf modes)
+    layouts=$(hyprctl -j getoption input:kb_layout 2>/dev/null | jq -r '.str // empty' || true)
+
+    # 2. Secondary: Query keyboards directly from devices JSON
+    if [[ -z "$layouts" || "$layouts" == "null" ]]; then
+        layouts=$(hyprctl -j devices 2>/dev/null | jq -r '[.keyboards[].layout | select(. != null and . != "")] | first // empty' || true)
+    fi
+
+    # 3. Fallback: Parse Lua configuration files
+    if [[ -z "$layouts" || "$layouts" == "null" ]]; then
+        local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
+        local hypr_dir="$config_home/hypr"
+        local lua_user="$hypr_dir/UserConfigs/user_settings.lua"
+        local lua_sys="$hypr_dir/configs/system_settings.lua"
+        local lua_legacy_sys="$hypr_dir/UserConfigs/system_settings.lua"
+        local lua_pristine_sys="$hypr_dir/lua/settings.lua"
+        if [[ -f "$lua_user" ]] && grep -q 'kb_layout' "$lua_user" 2>/dev/null; then
+            layouts=$(grep 'kb_layout' "$lua_user" | sed -n "s/.*kb_layout[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" | head -n1)
+        elif [[ -f "$lua_sys" ]] && grep -q 'kb_layout' "$lua_sys" 2>/dev/null; then
+            layouts=$(grep 'kb_layout' "$lua_sys" | sed -n "s/.*kb_layout[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" | head -n1)
+        elif [[ -f "$lua_legacy_sys" ]] && grep -q 'kb_layout' "$lua_legacy_sys" 2>/dev/null; then
+            layouts=$(grep 'kb_layout' "$lua_legacy_sys" | sed -n "s/.*kb_layout[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" | head -n1)
+        elif [[ -f "$lua_pristine_sys" ]] && grep -q 'kb_layout' "$lua_pristine_sys" 2>/dev/null; then
+            layouts=$(grep 'kb_layout' "$lua_pristine_sys" | sed -n "s/.*kb_layout[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" | head -n1)
+        fi
+    fi
+
+    echo "${layouts:-us}" | tr ',' ' '
+}
+
+raw_layouts=$(get_layouts)
+if [[ -z "$raw_layouts" ]]; then
+    echo "Error: cannot find kb_layout in configuration files or active session." >&2
+    exit 1
+fi
+
+kb_layouts=($raw_layouts)
+count=${#kb_layouts[@]}
+
+# Get current active window ID/address
+get_win() {
+  hyprctl activewindow -j 2>/dev/null | jq -r '.address // .id // empty'
+}
+
+# Save window-specific layout
+save_map() {
+  local W=$1 L=$2
+  grep -v "^${W}:" "$MAP_FILE" > "$MAP_FILE.tmp" 2>/dev/null || true
+  echo "${W}:${L}" >> "$MAP_FILE.tmp"
+  mv "$MAP_FILE.tmp" "$MAP_FILE"
+}
+
+# Load layout for window (fallback to default layout)
+load_map() {
+  local W=$1
+  local E
+  E=$(grep "^${W}:" "$MAP_FILE" 2>/dev/null || true)
+  [[ -n "$E" ]] && echo "${E#*:}" || echo "${kb_layouts[0]}"
+}
+
+# Switch layout for all keyboards to layout index.
+# NOTE: patched for Hyprland 0.56, which has no `switchxkblayout all`
+# (it answers "ok" but changes nothing), so every keyboard that has a
+# layout configured is switched individually.
+do_switch() {
+  local IDX=$1
+  local name
+  while read -r name; do
+    [[ -n "$name" ]] || continue
+    hyprctl switchxkblayout "$name" "$IDX" >/dev/null 2>&1 || true
+  done < <(hyprctl -j devices 2>/dev/null |
+    jq -r '.keyboards[] | select(.layout != null and .layout != "") | .name')
+}
+
+# Toggle layout for current window only
+cmd_toggle() {
+  local W
+  W=$(get_win)
+  [[ -z "$W" || "$W" == "null" ]] && return
+
+  local CUR
+  CUR=$(load_map "$W")
+  local i=0
+  local NEXT
+
+  for idx in "${!kb_layouts[@]}"; do
+    if [[ "${kb_layouts[idx]}" == "$CUR" ]]; then
+      i=$idx
+      break
+    fi
+  done
+
+  NEXT=$(( (i + 1) % count ))
+  do_switch "$NEXT"
+  save_map "$W" "${kb_layouts[NEXT]}"
+
+  if command -v notify-send >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
+    notify-send -e \
+      -h string:x-canonical-private-synchronous:kb_layout_notif \
+      -h boolean:SWAYNC_BYPASS_DND:true \
+      -u low \
+      -i "$ICON" \
+      " Keyboard Layout (Per-Window)" " ${kb_layouts[NEXT]}" 2>/dev/null || true
+  fi
+}
+
+# Restore layout on focus. Takes the window address, or looks it up.
+cmd_restore() {
+  local W=${1:-}
+  [[ -n "$W" ]] || W=$(get_win)
+  [[ -z "$W" || "$W" == "null" ]] && return
+
+  local LAY
+  LAY=$(load_map "$W")
+  for idx in "${!kb_layouts[@]}"; do
+    if [[ "${kb_layouts[idx]}" == "$LAY" ]]; then
+      do_switch "$idx"
+      break
+    fi
+  done
+}
+
+# Listen to focus events and restore window-specific layouts
+subscribe() {
+  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
+  local SOCKET2=""
+
+  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
+    SOCKET2="$runtime_dir/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
+  fi
+
+  if [[ ! -S "$SOCKET2" ]]; then
+    local sig
+    sig=$(hyprctl instances -j 2>/dev/null | jq -r '.[0].instance // empty')
+    [[ -n "$sig" ]] && SOCKET2="$runtime_dir/hypr/$sig/.socket2.sock"
+  fi
+
+  if [[ ! -S "$SOCKET2" ]]; then
+    echo "Error: Hyprland socket not found." >&2
+    exit 1
+  fi
+
+  if ! command -v socat >/dev/null 2>&1; then
+    echo "Error: socat is required for socket listening." >&2
+    exit 1
+  fi
+
+  # Only activewindowv2 carries the address. Hyprland re-sends it on every title
+  # change, so a terminal spinner or a browser tab fires it many times a second:
+  # act only when focus really moves to another window.
+  local last="" addr
+  socat -u UNIX-CONNECT:"$SOCKET2" - 2>/dev/null | while read -r line; do
+    [[ "$line" == activewindowv2\>\>* ]] || continue
+    addr="${line#activewindowv2>>}"
+    [[ -z "$addr" || "$addr" == "," || "$addr" == "$last" ]] && continue
+    last="$addr"
+    cmd_restore "0x$addr"
+  done
+}
+
+# CLI
+case "${1:-toggle}" in
+  --listener)
+    subscribe
+    ;;
+  status)
+    W=$(get_win)
+    load_map "$W"
+    ;;
+  toggle|"")
+    # Ensure only one listener is active
+    if ! pgrep -f "$SCRIPT_NAME.*--listener" >/dev/null 2>&1; then
+      "$SCRIPT_PATH" --listener &
+    fi
+    cmd_toggle
+    ;;
+  *)
+    echo "Usage: $SCRIPT_NAME [toggle|status]" >&2
+    exit 1
+    ;;
+esac
