diff --git a/dots/.config/matugen/templates/wallpaper-theme/design.py b/dots/.config/matugen/templates/wallpaper-theme/design.py
new file mode 100644
index 00000000..d8752731
--- /dev/null
+++ b/dots/.config/matugen/templates/wallpaper-theme/design.py
@@ -0,0 +1,764 @@
+"""Wallpaper -> design system. Every stage is deterministic and inspectable.
+
+ 1. sample     up to 100 representative shades of what is on screen (k-means
+               in OKLab, fixed seed), each with its share of the screen
+ 2. organise   shades -> hue families (basins of the hue histogram), each a
+               tonal ramp of real shades ordered by lightness; plus a neutral
+               ramp and the picture's own whites
+ 3. relate     complementary / opposite / analogous relations between the
+               families -> scheme type
+ 4. roles      fixed slots, like Catppuccin or Material: an 8-step surface
+               ramp, text roles at fixed contrast, three accent ramps with
+               balanced chroma, an error ramp; then an adjustment pass
+               (gamut, contrast, minimum distance between roles)
+
+Design targets come from measuring 143 published spicetify schemes: dark
+pages around L 0.24 with chroma ~0.015 (rarely above 0.035), nearly always
+cool blue-violet when coloured; side panel and player in the page's family
+slightly lower; cards +0.05, hover +0.09; accents around L 0.71-0.80,
+chroma ~0.10; light pages around L 0.97.
+"""
+
+import numpy as np
+
+# ---------- colour space (sRGB <-> OKLab / OKLCH) ----------
+
+def srgb_to_linear(c):
+    c = np.asarray(c, dtype=float)
+    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
+
+
+def linear_to_srgb(c):
+    c = np.asarray(c, dtype=float)
+    return np.where(c <= 0.0031308, c * 12.92, 1.055 * np.abs(c) ** (1 / 2.4) - 0.055)
+
+
+_M1 = np.array([[0.4122214708, 0.5363325363, 0.0514459929],
+                [0.2119034982, 0.6806995451, 0.1073969566],
+                [0.0883024619, 0.2817188376, 0.6299787005]])
+_M2 = np.array([[0.2104542553, 0.7936177850, -0.0040720468],
+                [1.9779984951, -2.4285922050, 0.4505937099],
+                [0.0259040371, 0.7827717662, -0.8086757660]])
+_M1I, _M2I = np.linalg.inv(_M1), np.linalg.inv(_M2)
+
+
+def rgb_to_oklab(rgb):
+    """rgb in 0..1, shape (..., 3)"""
+    return np.cbrt(srgb_to_linear(rgb) @ _M1.T) @ _M2.T
+
+
+def oklab_to_rgb(lab):
+    return linear_to_srgb(((np.asarray(lab, dtype=float) @ _M2I.T) ** 3) @ _M1I.T)
+
+
+def in_gamut(rgb, eps=1e-4):
+    return bool(np.all(rgb >= -eps) and np.all(rgb <= 1 + eps))
+
+
+def lch(lab):
+    L, a, b = lab
+    return float(L), float(np.hypot(a, b)), float(np.degrees(np.arctan2(b, a)) % 360)
+
+
+def from_lch(L, C, h):
+    """OKLCH -> OKLab; out-of-gamut colours lose chroma, never hue or lightness."""
+    L = min(max(L, 0.0), 1.0)
+    C = max(C, 0.0)
+    hr = np.radians(h)
+    ab = lambda c: np.array([L, c * np.cos(hr), c * np.sin(hr)])
+    if in_gamut(oklab_to_rgb(ab(C))):
+        return ab(C)
+    lo, hi = 0.0, C
+    for _ in range(24):
+        mid = (lo + hi) / 2
+        lo, hi = (mid, hi) if in_gamut(oklab_to_rgb(ab(mid))) else (lo, mid)
+    return ab(lo)
+
+
+def from_hex(h):
+    h = h.lstrip("#")
+    return rgb_to_oklab(np.array([int(h[i:i + 2], 16) for i in (0, 2, 4)]) / 255)
+
+
+def to_hex(lab):
+    rgb = np.clip(oklab_to_rgb(lab), 0, 1)
+    return "".join(f"{round(v * 255):02x}" for v in rgb)
+
+
+def luminance(lab):
+    lin = srgb_to_linear(np.clip(oklab_to_rgb(lab), 0, 1))
+    return float(lin @ [0.2126, 0.7152, 0.0722])
+
+
+def contrast(a, b):
+    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
+    return (la + 0.05) / (lb + 0.05)
+
+
+def hue_gap(h1, h2):
+    d = abs(h1 - h2) % 360
+    return min(d, 360 - d)
+
+
+def mix(a, b, t):
+    return (1 - t) * np.asarray(a, dtype=float) + t * np.asarray(b, dtype=float)
+
+
+def between(a, b, t=0.5):
+    """Colour between a and b the short way round the hue circle."""
+    La, Ca, ha = lch(a)
+    Lb, Cb, hb = lch(b)
+    ha = hb if Ca < 0.02 else ha
+    hb = ha if Cb < 0.02 else hb
+    dh = ((hb - ha + 180) % 360) - 180
+    return from_lch(La + (Lb - La) * t, Ca + (Cb - Ca) * t, ha + dh * t)
+
+
+def dist(a, b):
+    return float(np.linalg.norm(np.asarray(a) - np.asarray(b)))
+
+
+def opposite(lab):
+    """RGB inverse: yellow -> blue, light -> dark."""
+    return rgb_to_oklab(1 - np.clip(oklab_to_rgb(lab), 0, 1))
+
+
+def rotate(lab, degrees):
+    L, C, h = lch(lab)
+    return from_lch(L, C, (h + degrees) % 360)
+
+
+def circular_mean(h, w=None):
+    r = np.radians(np.asarray(h, dtype=float))
+    return float(np.degrees(np.arctan2(np.average(np.sin(r), weights=w),
+                                       np.average(np.cos(r), weights=w))) % 360)
+
+
+def max_chroma(L, h):
+    """Highest chroma sRGB can show at each lightness/hue (vectorised)."""
+    L, h = np.atleast_1d(L).astype(float), np.atleast_1d(h).astype(float)
+    hr = np.radians(h)
+    lo, hi = np.zeros_like(L), np.full_like(L, 0.4)
+    for _ in range(22):
+        mid = (lo + hi) / 2
+        ok = np.all(np.abs(oklab_to_rgb(np.stack([L, mid * np.cos(hr), mid * np.sin(hr)], -1)) - 0.5)
+                    <= 0.5 + 1e-4, -1)
+        lo, hi = np.where(ok, mid, lo), np.where(ok, hi, mid)
+    return lo
+
+
+BLACK = rgb_to_oklab(np.zeros(3))
+WHITE = rgb_to_oklab(np.ones(3))
+
+
+# ---------- 1. sample ----------
+
+def sample(px, rows, k=100):
+    """Up to k representative shades: deterministic k-means in OKLab."""
+    lab = rgb_to_oklab(px)
+    n = len(lab)
+    uniq = np.unique(np.round(lab, 3), axis=0)
+    k = int(min(k, len(uniq)))
+    rng = np.random.default_rng(0)
+    # k-means++ seeding on a fixed subsample, then Lloyd iterations on all
+    sub = lab[rng.choice(n, min(n, 6000), replace=False)]
+    centers = [sub[0]]
+    d2 = ((sub - centers[0]) ** 2).sum(1)
+    for _ in range(1, k):
+        if d2.sum() == 0:
+            break
+        c = sub[rng.choice(len(sub), p=d2 / d2.sum())]
+        centers.append(c)
+        d2 = np.minimum(d2, ((sub - c) ** 2).sum(1))
+    centers = np.array(centers)
+    x2 = (lab ** 2).sum(1)[:, None]
+    for _ in range(20):
+        dd = x2 + (centers ** 2).sum(1)[None] - 2 * lab @ centers.T
+        labels = np.argmin(dd, 1)
+        counts = np.bincount(labels, minlength=len(centers))
+        new = np.array([lab[labels == i].mean(0) if counts[i] else centers[i]
+                        for i in range(len(centers))])
+        if np.abs(new - centers).max() < 1e-4:
+            centers = new
+            break
+        centers = new
+    counts = np.bincount(labels, minlength=len(centers))
+    row_mean = np.bincount(labels, weights=rows, minlength=len(centers)) / np.maximum(counts, 1)
+    shades = []
+    for i, c in enumerate(centers):
+        share = counts[i] / n
+        if share < 0.001:
+            continue
+        L, C, h = lch(c)
+        shades.append({"lab": c, "L": L, "C": C, "h": h, "share": float(share),
+                       "row": float(row_mean[i])})
+    if shades:
+        rel = np.array([s["C"] for s in shades]) / np.maximum(
+            max_chroma([s["L"] for s in shades], [s["h"] for s in shades]), 1e-6)
+        for s, r in zip(shades, rel):
+            s["rel"] = float(r)
+    return sorted(shades, key=lambda s: -s["share"])
+
+
+# ---------- 2. organise ----------
+
+RELATIVE_CHROMA = 0.15   # share of the possible chroma that makes a shade "coloured"
+MIN_FAMILY = 0.015       # families under this share merge into a neighbour
+
+
+def organise(shades):
+    coloured = [s for s in shades if s["rel"] >= RELATIVE_CHROMA and s["C"] >= 0.02]
+    picked = {id(s) for s in coloured}
+    neutral = [s for s in shades if id(s) not in picked]
+
+    families = []
+    if coloured:
+        # Hue histogram (5 degree bins, weighted by screen share), smoothed;
+        # every bin climbs to its local peak: one family per basin.
+        hist = np.zeros(72)
+        for s in coloured:
+            hist[int(s["h"] // 5) % 72] += s["share"]
+        kern = np.exp(-0.5 * (np.arange(-6, 7) / 1.5) ** 2)    # 7.5 degree smoothing
+        sm = np.array([np.dot(hist[np.arange(i - 6, i + 7) % 72], kern) for i in range(72)])
+
+        def peak_of(i):
+            while True:
+                j = max((i - 1) % 72, i, (i + 1) % 72, key=lambda b: (sm[b], -abs(b - i)))
+                if j == i:
+                    return i
+                i = j
+        basins = {}
+        for s in coloured:
+            basins.setdefault(peak_of(int(s["h"] // 5) % 72), []).append(s)
+        groups = list(basins.values())
+        # merge slivers into the nearest family in hue
+        groups.sort(key=lambda g: -sum(s["share"] for s in g))
+        big = [g for g in groups if sum(s["share"] for s in g) >= MIN_FAMILY] or groups[:1]
+        for g in groups:
+            if any(g is b for b in big):
+                continue
+            gh = circular_mean([s["h"] for s in g], [s["share"] for s in g])
+            near = min(big, key=lambda b: hue_gap(gh, circular_mean([s["h"] for s in b],
+                                                                     [s["share"] for s in b])))
+            if hue_gap(gh, circular_mean([s["h"] for s in near], [s["share"] for s in near])) <= 40:
+                near.extend(g)
+            else:
+                neutral.extend(g)       # an isolated speck of colour is not a family
+        families = [family(g) for g in big]
+        families.sort(key=lambda f: -f["share"])
+
+    neutral.sort(key=lambda s: s["L"])
+    total_n = sum(s["share"] for s in neutral)
+    whites = [s for s in shades if s["L"] > 0.85 and s["C"] < 0.04]
+    w_share = sum(s["share"] for s in whites)
+    return {
+        "shades": shades,
+        "families": families,
+        "neutral": {"shades": neutral, "share": total_n,
+                    "hue": circular_mean([s["h"] for s in neutral], [s["share"] * s["C"] + 1e-9 for s in neutral])
+                    if neutral else 0.0},
+        "whites": {"share": w_share,
+                   "lab": np.average([s["lab"] for s in whites], axis=0, weights=[s["share"] for s in whites])
+                   if whites else WHITE},
+        "mean_L": float(sum(s["L"] * s["share"] for s in shades) / max(sum(s["share"] for s in shades), 1e-9)),
+    }
+
+
+def family(group):
+    """A hue family: its shades ordered by lightness form a real tonal ramp."""
+    group = sorted(group, key=lambda s: s["L"])
+    w = np.array([s["share"] for s in group])
+    L = np.array([s["L"] for s in group])
+    C = np.array([s["C"] for s in group])
+    h = np.array([s["h"] for s in group])
+    share = float(w.sum())
+    hue = circular_mean(h, w * C)
+    # chroma and hue the photo has at each lightness (bins of 0.1, filled)
+    bins = np.linspace(0.05, 0.95, 10)
+    idx = np.clip(np.digitize(L, bins) - 1, 0, 9)
+    c_at, h_at = np.full(10, np.nan), np.full(10, np.nan)
+    for i in range(10):
+        m = idx == i
+        if m.any():
+            # the more saturated end of what is there: what the eye remembers
+            order = np.argsort(C[m])
+            cw = np.cumsum(w[m][order]) / w[m].sum()
+            c_at[i] = C[m][order][np.searchsorted(cw, 0.7)]
+            h_at[i] = circular_mean(h[m], w[m] * C[m])
+    have = ~np.isnan(c_at)
+    c_at = np.interp(bins, bins[have], c_at[have])
+    # hue drift across lightness (shadows vs highlights), unwrapped round the mean
+    rel = ((h_at[have] - hue + 180) % 360) - 180
+    h_at = hue + np.interp(bins, bins[have], rel)
+    vivid_i = int(np.argmax(C * np.sqrt(w)))
+    order = np.argsort(C)
+    cw = np.cumsum(w[order]) / share
+    return {
+        "shades": group, "share": share, "hue": hue,
+        "L_range": (float(np.average(L, weights=w) - np.sqrt(np.cov(L, aweights=w) if len(L) > 1 else 0)),
+                    float(np.average(L, weights=w) + np.sqrt(np.cov(L, aweights=w) if len(L) > 1 else 0))),
+        "L_mean": float(np.average(L, weights=w)),
+        "lstd": float(np.sqrt(np.cov(L, aweights=w))) if len(L) > 1 else 0.0,
+        "C_vivid": float(C[order][np.searchsorted(cw, 0.85)]),
+        "vivid": group[vivid_i]["lab"],
+        "row": float(np.average([s["row"] for s in group], weights=w)),
+        "profile": {"L": bins, "C": c_at, "h": h_at},
+    }
+
+
+def tone(src, L, chroma=None, cap=None):
+    """A family's own shade at lightness L: the chroma and hue the photo has
+    for it there (or `chroma` if given), capped."""
+    if isinstance(src, dict):
+        C = float(np.interp(L, src["profile"]["L"], src["profile"]["C"])) if chroma is None else chroma
+        h = float(np.interp(L, src["profile"]["L"], src["profile"]["h"])) % 360
+    else:
+        _, C0, h = lch(src)
+        C = C0 if chroma is None else chroma
+    if cap is not None:
+        C = min(C, cap)
+    return from_lch(L, C, h)
+
+
+def hue_of(src):
+    return src["hue"] if isinstance(src, dict) else lch(src)[2]
+
+
+# ---------- 3. relate ----------
+
+def relate(scene):
+    fams = [f for f in scene["families"] if f["share"] >= 0.03]
+    pairs = []
+    for i, a in enumerate(fams):
+        for b in fams[i + 1:]:
+            d = hue_gap(a["hue"], b["hue"])
+            comp = max(0.0, 1 - abs(180 - d) / 50)          # 1 at exactly opposite
+            pairs.append({"a": a, "b": b, "gap": d, "complementary": comp,
+                          "score": comp * np.sqrt(a["share"] * b["share"])})
+    pairs.sort(key=lambda p: -p["score"])
+    hues = sorted(f["hue"] for f in fams)
+    if not fams:
+        kind = "monochrome"
+    elif len(fams) == 1:
+        kind = "single colour"
+    else:
+        # smallest arc that holds every family
+        gaps = [(hues[(i + 1) % len(hues)] - hues[i]) % 360 for i in range(len(hues))]
+        arc = 360 - max(gaps)
+        if pairs and pairs[0]["complementary"] >= 0.5:
+            kind = "complementary"
+        elif arc <= 90:
+            kind = "analogous"
+        elif len(fams) >= 3 and arc >= 200:
+            kind = "triadic"
+        else:
+            kind = "split-complementary"
+    return {"kind": kind, "pairs": pairs, "families": fams}
+
+
+# ---------- 3b. complete ----------
+#
+# A picture rarely holds a whole palette: green and black give two colours,
+# a theme needs six or more. Count the colours the picture does show, number
+# them, measure how far apart they are, then add the ones colour harmony asks
+# for: complements, split complements, analogous and triad hues.
+#
+# Harmony is measured on the painter's (RYB) wheel, where green faces rose/red
+# and yellow faces violet, not on OKLCH's, where green faces blue-violet.
+# Anchors: OKLCH hue of each RYB hue, measured from sRGB primaries.
+RYB_ANCHORS = np.array([(0, 29), (60, 53), (120, 110), (180, 142), (240, 264),
+                        (270, 294), (300, 328), (330, 365), (360, 389)], dtype=float)
+# relation, RYB offset, weight: how strongly harmony asks for that hue
+RELATIONS = [("complement", 180, 1.0), ("split complement", 150, 0.9), ("split complement", 210, 0.9),
+             ("triad", 120, 0.65), ("triad", 240, 0.65), ("analogous", 30, 0.75), ("analogous", -30, 0.75)]
+PALETTE_SIZE = 8
+MIN_RYB_GAP = 28          # two palette hues closer than this read as one colour
+MAX_PICTURE = 4           # picture colours kept as their own palette hues
+HUE_NAMES = [(5, "rose"), (29, "red"), (53, "orange"), (80, "ochre"), (110, "yellow"),
+             (125, "olive"), (142, "green"), (180, "teal"), (215, "cyan"), (250, "azure"),
+             (264, "blue"), (294, "violet"), (328, "magenta"), (350, "pink")]
+
+
+def to_ryb(h):
+    h = h % 360
+    if h < RYB_ANCHORS[0, 1]:
+        h += 360
+    return float(np.interp(h, RYB_ANCHORS[:, 1], RYB_ANCHORS[:, 0])) % 360
+
+
+def from_ryb(r):
+    return float(np.interp(r % 360, RYB_ANCHORS[:, 0], RYB_ANCHORS[:, 1])) % 360
+
+
+def ryb_gap(a, b):
+    return hue_gap(to_ryb(a), to_ryb(b))
+
+
+def hue_name(h):
+    return min(HUE_NAMES, key=lambda n: hue_gap(h, n[0]))[1]
+
+
+def highlights(scene):
+    """Every distinct colour the picture shows, most salient first: its hue
+    families, plus small vivid highlights organise() folded into the
+    neutrals (a red mouth, a yellow lamp)."""
+    out = [{"hue": f["hue"], "share": f["share"], "C": f["C_vivid"], "lab": f["vivid"],
+            "family": f} for f in scene["families"]]
+    specks = sorted((s for s in scene["neutral"]["shades"] if s.get("rel", 0) >= 0.3 and s["C"] >= 0.05),
+                    key=lambda s: -s["C"] * np.sqrt(s["share"]))
+    for s in specks:
+        same = next((o for o in out if hue_gap(o["hue"], s["h"]) <= 25), None)
+        if same is None:
+            out.append({"hue": s["h"], "share": s["share"], "C": s["C"], "lab": s["lab"], "family": None})
+        elif same["family"] is None:
+            same["share"] += s["share"]
+    for o in out:
+        o["salience"] = float(np.sqrt(o["share"]) * o["C"])
+    return sorted(out, key=lambda o: -o["salience"])
+
+
+def complete(scene, size=PALETTE_SIZE):
+    """Picture colours + the hues harmony asks for, numbered.
+
+    1. number the picture's colours by salience (H1, H2, ...), merging any two
+       closer than MIN_RYB_GAP on the painter's wheel
+    2. measure the gaps between them (painter's wheel, degrees)
+    3. every picture colour proposes its complement, split complements,
+       triad and analogous hues; candidates are scored by relation weight x
+       the parent's salience x their distance from hues already chosen, and
+       added greedily until the palette is full or nothing fits
+    A grey picture gets no hues: monochrome by design."""
+    hl = highlights(scene)
+    top = max((h["salience"] for h in hl), default=0) or 1
+    palette = []
+    for h in hl:
+        if len(palette) >= MAX_PICTURE:
+            break
+        if all(ryb_gap(h["hue"], p["hue"]) >= MIN_RYB_GAP for p in palette):
+            palette.append({"hue": h["hue"], "origin": "picture", "relation": None, "parent": None,
+                            "weight": h["salience"] / top, "C": h["C"], "share": h["share"],
+                            "family": h["family"]})
+    for i, p in enumerate(palette):
+        p["id"] = f"H{i + 1}"
+    gaps = [(a["id"], b["id"], round(ryb_gap(a["hue"], b["hue"])))
+            for i, a in enumerate(palette) for b in palette[i + 1:]]
+
+    pictured = list(palette)
+    while palette and len(palette) < size:
+        best = None
+        for p in pictured:
+            for rel_name, off, w in RELATIONS:
+                h = from_ryb(to_ryb(p["hue"]) + off)
+                d = min(ryb_gap(h, q["hue"]) for q in palette)
+                if d < MIN_RYB_GAP:
+                    continue
+                score = w * np.sqrt(p["weight"]) * min(1.0, d / 60)
+                if best is None or score > best[0]:
+                    best = (score, h, rel_name, p)
+        if best is None:
+            break
+        _, h, rel_name, p = best
+        palette.append({"hue": h, "origin": "made", "relation": rel_name, "parent": p["id"],
+                        "weight": float(best[0]), "C": p["C"], "share": 0.0, "family": None,
+                        "id": f"G{len(palette) - len(pictured) + 1}"})
+    for p in palette:
+        p["name"] = hue_name(p["hue"])
+    return {"colours": palette, "gaps": gaps}
+
+
+def palette_lab(entry, L=0.70, C=0.12):
+    """A palette hue as a colour: the picture's own shade where it has one."""
+    if entry.get("family") is not None:
+        return tone(entry["family"], L, chroma=C)
+    return from_lch(L, C, entry["hue"])
+
+
+# ---------- 4. roles ----------
+
+FLAT_SHARE = 0.6
+
+# surface ladder, offsets from the page (dark themes go up, light ones down)
+SURFACE_STEPS = {"player": -0.05, "sidebar": -0.025, "page": 0.0, "elevated": 0.045,
+                 "card": 0.055, "highlight": 0.09, "pressed": 0.12, "misc": 0.16}
+# accent ramp: tones (lightness) for container .. on-container
+ACCENT_TONES_DARK = {"container": 0.38, "strong": 0.64, "main": 0.80, "soft": 0.87, "on": 0.94}
+ACCENT_TONES_LIGHT = {"container": 0.90, "strong": 0.58, "main": 0.50, "soft": 0.42, "on": 0.25}
+
+
+def coolness(h):
+    """1 for blue-violet (what good dark surfaces use), down to 0.2 for warm/green."""
+    if 215 <= h <= 315:
+        return 1.0
+    if 190 <= h < 215 or 315 < h <= 340:
+        return 0.6
+    return 0.2
+
+
+def design(scene, rel, desktop_primary=None):
+    fams = scene["families"]
+    neutral = scene["neutral"]
+    top = fams[0] if fams else None
+    flat = bool(top and top["share"] >= FLAT_SHARE and top["lstd"] < 0.06)
+    flat_neutral = (not flat and neutral["share"] >= FLAT_SHARE and fams == [] and
+                    np.std([s["L"] for s in neutral["shades"]]) < 0.06) if neutral["shades"] else False
+    log = []
+    pal = complete(scene)
+    if pal["colours"]:
+        log.append("palette: " + ", ".join(
+            f"{c['id']} {c['name']} {c['hue']:.0f}°" + (f" ({c['relation']} of {c['parent']})" if c["parent"] else "")
+            for c in pal["colours"]))
+
+    def harmony_pick(*taken, want=None):
+        """The palette hue harmony ranks highest that is not already taken
+        (MIN_RYB_GAP apart from each taken hue). want=(hue, degrees) prefers
+        the hue closest to that painter's-wheel distance from `hue`."""
+        free = [c for c in pal["colours"] if all(ryb_gap(c["hue"], t) >= MIN_RYB_GAP for t in taken)]
+        if not free:
+            return None
+        if want:
+            h0, deg = want
+            c = min(free, key=lambda c: (round(abs(deg - ryb_gap(c["hue"], h0)) / 20), -c["weight"]))
+        else:
+            c = max(free, key=lambda c: min((ryb_gap(c["hue"], t) for t in taken), default=180) / 180
+                    + 0.3 * c["weight"])
+        return palette_lab(c)
+
+    # how much bright, colourful content the picture has (0..1): sunlit fur,
+    # neon, a sunset. Bright pictures get a livelier page, header and accents.
+    bright = sum(sh["share"] for f in fams for sh in f["shades"] if sh["L"] >= 0.62 and sh["C"] >= 0.07)
+    glow = float(min(1.0, bright / 0.20))      # 20% of the screen bright and vivid = full glow
+
+    # ---- mode ----
+    if flat:
+        base_lab = tone(top, top["L_mean"])
+        light = contrast(base_lab, BLACK) >= contrast(base_lab, WHITE)
+    else:
+        light = scene["mean_L"] >= 0.62
+    up = -1 if light else 1
+    ink = BLACK if light else WHITE
+    log.append(f"mode: {'light' if light else 'dark'} (picture lightness {scene['mean_L']:.2f}{', flat' if flat else ''})")
+
+    # ---- surface family ----
+    if flat:
+        surface_src, cap = top, 1.0
+        page = np.array(tone(top, top["L_mean"], chroma=float(np.median([s['C'] for s in top['shades']]))))
+        page_L = lch(page)[0]
+        log.append("surface: the flat colour itself, exactly")
+    else:
+        cands = [(f["share"] * (coolness(f["hue"]) if not light else 1.0), f) for f in fams]
+        cands.append((neutral["share"] * 0.5, "neutral"))
+        score, pick = max(cands, key=lambda c: c[0])
+        if pick == "neutral" or not fams:
+            surface_src = from_lch(0.5, 0.01, neutral["hue"])
+            cap = 0.01
+        else:
+            surface_src = pick
+            cap = (0.016 if light else 0.034) if (light or coolness(pick["hue"]) >= 0.6) else 0.012
+        page_L = 0.965 if light else float(np.clip(0.20 + 0.10 * scene["mean_L"] + 0.05 * glow, 0.22, 0.31))
+        cap = cap * (1 + 0.25 * glow) if not light else cap
+        page = tone(surface_src, page_L, cap=cap)
+        log.append(f"surface: {'neutral' if pick == 'neutral' else 'family at %d°' % surface_src['hue']}"
+                   f", chroma budget {cap:.3f}, page L {page_L:.3f}")
+
+    surfaces = {}
+    for name, off in SURFACE_STEPS.items():
+        L = page_L + up * off
+        if flat:
+            _, C, h = lch(page)
+            surfaces[name] = from_lch(L, C * (1 - 0.15 * abs(off) / 0.16), h)
+        else:
+            surfaces[name] = tone(surface_src, L, cap=cap * (1 + 0.3 * max(off, 0) / 0.16))
+    surfaces["page"] = page
+
+    # ---- accents ----
+    accent_cands = [f for f in fams if f is not surface_src]
+    def salience(f):
+        return np.sqrt(f["share"]) * f["C_vivid"]
+    primary = None
+    if desktop_primary is not None and not flat:
+        dh = lch(desktop_primary)[2]
+        near = [f for f in accent_cands if hue_gap(f["hue"], dh) <= 35]
+        if near:
+            fam = max(near, key=salience)
+            # the bar, btop and window borders already show matugen's take on
+            # this colour: keep the family's shades but use the desktop's hue
+            primary = {**fam, "hue": dh,
+                       "profile": {**fam["profile"], "h": np.full_like(fam["profile"]["h"], dh)}}
+            primary["_family"] = fam
+            log.append(f"primary: family at {fam['hue']:.0f}°, in the desktop's hue {dh:.0f}°")
+    synthetic = []
+    if flat:
+        # the user's rule for one colour: opposite, complementary, colours in between
+        base = page
+        prim = opposite(base)
+        sec = from_lch(*lch(base)[:2], from_ryb(to_ryb(lch(base)[2]) + 180))
+        if hue_gap(lch(prim)[2], lch(sec)[2]) < 40 or lch(prim)[1] < 0.04:
+            sec = max((rotate(base, 150), rotate(base, 210)), key=lambda c: hue_gap(lch(c)[2], lch(prim)[2]))
+        others = [f for f in accent_cands]
+        if others:            # a flat field with real second colours: use them first
+            prim = max(others, key=salience)
+            rest = [f for f in others if f is not prim]
+            sec = max(rest, key=lambda f: max(0, 1 - abs(180 - hue_gap(f["hue"], hue_of(prim))) / 90) + salience(f)) \
+                if rest else rotate(prim["vivid"], 180)
+        ter = between(base, prim if not isinstance(prim, dict) else prim["vivid"])
+        accents_src = [prim, sec, ter]
+        log.append("accents: flat-colour rule (opposite, complementary, in between)")
+    else:
+        if primary is None:
+            primary = max(accent_cands, key=salience) if accent_cands else None
+        if primary is None:
+            # nothing but the surface colour: opposite and complementary of it
+            base_lab = surface_src["vivid"] if isinstance(surface_src, dict) else surface_src
+            if lch(base_lab)[1] < 0.03:
+                primary = from_lch(0.7, 0.0, 0.0)
+                synthetic.append("primary")
+            else:
+                primary = harmony_pick(lch(base_lab)[2], want=(lch(base_lab)[2], 180))
+                if primary is None:
+                    primary = rotate(base_lab, 180)
+                synthetic.append("primary")
+        ph = hue_of(primary)
+        rest = [f for f in accent_cands if f is not primary and f is not primary.get("_family") ] \
+            if isinstance(primary, dict) else list(accent_cands)
+        # secondary: closest to the primary's opposite, weighted by presence
+        def opp_score(f):
+            return max(0.0, 1 - abs(180 - hue_gap(f["hue"], ph)) / 90) * np.sqrt(f["share"]) + 0.2 * salience(f)
+        sec = max(rest, key=opp_score) if rest else None
+        if sec is None or hue_gap(sec["hue"], ph) < 40:
+            pv = primary["vivid"] if isinstance(primary, dict) else primary
+            sec = None
+            if desktop_primary is not None:
+                # the bar, btop and window borders already show matugen's
+                # accent: if it sits on the far side of the wheel, it is the
+                # opposite colour this picture needs
+                Ld, Cd, dh = lch(desktop_primary)
+                if Cd >= 0.03 and ryb_gap(dh, ph) >= 120:
+                    sec = from_lch(0.7, 0.12, dh)
+                    log.append(f"secondary: the desktop's accent {dh:.0f}° (opposite the primary)")
+            if sec is None:
+                # the painter's complement: green -> rose, yellow -> violet
+                sec = harmony_pick(ph, want=(ph, 180))
+            if sec is None:
+                sec = rotate(pv, 180)
+            synthetic.append("secondary")
+        sh = hue_of(sec)
+        rest = [f for f in rest if f is not sec]
+        # tertiary: the remaining family furthest from both (triad-like)
+        def ter_score(f):
+            return min(hue_gap(f["hue"], ph), hue_gap(f["hue"], sh)) / 180 + salience(f) * 2
+        # a real wallpaper colour beats an invented one, even fairly close in
+        # hue: the adjustment pass keeps it apart by lightness
+        ter = max([f for f in rest if min(hue_gap(f["hue"], ph), hue_gap(f["hue"], sh)) >= 20],
+                  key=ter_score, default=None)
+        if ter is None:
+            pv = primary["vivid"] if isinstance(primary, dict) else primary
+            ter = harmony_pick(ph, sh)
+            if ter is None:
+                cand = [rotate(pv, 120), rotate(pv, -120)]
+                ter = max(cand, key=lambda c: hue_gap(lch(c)[2], sh))
+            synthetic.append("tertiary")
+        accents_src = [primary, sec, ter]
+        log.append(f"accents: {', '.join('%s %.0f°%s' % (n, hue_of(s), ' (made up)' if n in synthetic else '') for n, s in zip(('primary', 'secondary', 'tertiary'), accents_src))}")
+
+    # balanced chroma: every accent's main tone gets the same perceived
+    # vividness (median of what the photo offers, kept in a pleasant band)
+    vivid_C = [s["C_vivid"] if isinstance(s, dict) else lch(s)[1] for s in accents_src]
+    target_C = float(np.clip(np.median([c for c in vivid_C if c > 0.02] or [0.1]) * 1.6, 0.09, 0.15 + 0.02 * glow))
+    if lch(page)[1] < 0.02 and all(c < 0.03 for c in vivid_C):
+        target_C = 0.0     # grey picture: monochrome by design
+    tones = ACCENT_TONES_LIGHT if light else ACCENT_TONES_DARK
+    ramps = {}
+    for name, src in zip(("primary", "secondary", "tertiary"), accents_src):
+        ramp = {}
+        for tname, L in tones.items():
+            c = target_C * (0.45 if tname in ("container", "on") else 1.0)
+            ramp[tname] = tone(src, L, chroma=c)
+        ramps[name] = ramp
+    ramps["error"] = {t: from_lch(L, target_C * (0.45 if t in ("container", "on") else 1.0) or 0.12, 25)
+                      for t, L in tones.items()}
+
+    # ---- adjustment pass ----
+    # accents must stand out from the page and the cards (3:1) ...
+    for name, ramp in ramps.items():
+        for _ in range(40):
+            m = ramp["main"]
+            if min(contrast(m, page), contrast(m, surfaces["card"])) >= 3.0:
+                break
+            L, C, h = lch(m)
+            ramp["main"] = from_lch(L + up * 0.01, C, h)
+    # ... and from each other (minimum OKLab distance between main tones)
+    names = ["primary", "secondary", "tertiary"]
+    for i, n in enumerate(names):
+        for _ in range(8):
+            close = [o for o in names[:i] if dist(ramps[n]["main"], ramps[o]["main"]) < 0.06]
+            if not close:
+                break
+            L, C, h = lch(ramps[n]["main"])
+            ramps[n]["main"] = from_lch(L + up * 0.04, C, h)
+            log.append(f"adjust: {n} lightened to stay apart from {close[0]}")
+    # error must not look like an accent
+    # (a rose accent sits next to red: step the hue a little either way, and if
+    # that is not enough change the lightness, so the error still reads as red)
+    L0, C0, h0 = lch(ramps["error"]["main"])
+    def apart(c):
+        return min(dist(c, ramps[o]["main"]) for o in names)
+    tries = [from_lch(L0 + dl, C0, (h0 + dh) % 360)
+             for dl in (0.0, -0.08, -0.14) for dh in (0, 8, -8, 16, -16)]
+    ok = [c for c in tries if apart(c) >= 0.07]
+    ramps["error"]["main"] = ok[0] if ok else max(tries, key=apart)
+
+    # ---- text ----
+    if not light and not flat and scene["whites"]["share"] >= 0.01:
+        _, Cw, hw = lch(scene["whites"]["lab"])
+        text0 = from_lch(0.95, min(Cw, 0.02), hw)
+        log.append("text: tinted with the picture's own white")
+    else:
+        Lt, Ct, ht = lch(mix(opposite(page), ink, 0.8))
+        text0 = from_lch(Lt, min(Ct, 0.035), ht)
+        log.append("text: the page's opposite colour mixed with " + ("black" if light else "white"))
+
+    def reach(color, bgs, target):
+        for t in np.linspace(0, 1, 41):
+            c = mix(color, ink, t)
+            if all(contrast(c, b) >= tg for b, tg in zip(bgs, target)):
+                return c
+        return np.array(ink)
+    text = reach(text0, [page, surfaces["pressed"]], [7.0, 4.5])
+    subtext = reach(mix(text, page, 0.35), [page, surfaces["highlight"]], [4.5, 4.5])
+    disabled = mix(page, subtext, 0.45)
+
+    # header gradient: the picture's most expressive colour (big, vivid and
+    # bright), as a real, clearly brighter shade of it, fading into the page;
+    # like Spotify's own album headers, but from the wallpaper
+    if fams and not flat:
+        def expressive(f):
+            lit = sum(sh["share"] for sh in f["shades"] if sh["L"] >= 0.55)
+            return (f["share"] + 2 * lit) * f["C_vivid"]
+        glow_fam = max(fams, key=expressive)
+        g_L = page_L + up * (0.14 + 0.16 * glow)
+        g_C = float(np.interp(g_L, glow_fam["profile"]["L"], glow_fam["profile"]["C"]))
+        gradient_top = tone(glow_fam, g_L, chroma=float(np.clip(g_C * 1.4, 0.05, 0.08 + 0.07 * glow)))
+        log.append(f"header: family at {glow_fam['hue']:.0f}°, L {g_L:.2f} (picture glow {glow:.2f})")
+    else:
+        glow_fam = None
+        gradient_top = surfaces["highlight"]
+
+    return {
+        "light": light, "flat": flat, "kind": rel["kind"], "log": log,
+        "surfaces": surfaces, "ramps": ramps, "text": text, "subtext": subtext, "disabled": disabled,
+        "gradient_top": gradient_top, "accent_src": accents_src, "surface_src": surface_src,
+        "synthetic": synthetic, "palette": pal,
+    }
+
+
+def checks(d):
+    """Contrast table for the inspection sheet."""
+    s, r = d["surfaces"], d["ramps"]
+    rows = [("text on page", contrast(d["text"], s["page"]), 7.0),
+            ("text on hover", contrast(d["text"], s["pressed"]), 4.5),
+            ("subtext on page", contrast(d["subtext"], s["page"]), 4.5),
+            ("subtext on hover", contrast(d["subtext"], s["highlight"]), 4.5)]
+    for n in ("primary", "secondary", "tertiary", "error"):
+        rows.append((f"{n} on page", contrast(r[n]["main"], s["page"]), 3.0))
+        rows.append((f"{n} on card", contrast(r[n]["main"], s["card"]), 3.0))
+    return rows
