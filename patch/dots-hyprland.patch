+// Wallpaper theme, runtime part.
+(function wallpaperTheme() {
+  // 1. Pick up new colours and styles without restarting Spotify:
+  //    `spicetify refresh -n` rewrites colors.css and user.css after a
+  //    wallpaper change; reload each stylesheet when its contents change.
+  const last = {};
+  async function check(name) {
+    const link = document.querySelector(`link[href*="${name}"]`);
+    if (!link) return;
+    try {
+      const url = link.href.split("?")[0];
+      const css = await (await fetch(`${url}?t=${Date.now()}`, { cache: "no-store" })).text();
+      if (last[name] !== undefined && css !== last[name]) link.href = `${url}?t=${Date.now()}`;
+      last[name] = css;
+    } catch (e) { /* file mid-write; try again next round */ }
+  }
+  setInterval(() => { check("colors.css"); check("user.css"); }, 2000);
+
+  // 2. Headers tinted from album art (home, album, playlist, artist pages) get
+  //    an inline background colour no stylesheet variable reaches, under a
+  //    60% black overlay. Give them the wallpaper's header gradient instead:
+  //    its most expressive colour fading into the page. Images and the right
+  //    panel (cover, Canvas) are left alone.
+  function neutralise() {
+    const view = document.querySelector(".Root__main-view");
+    if (!view) return;
+    const min = view.clientWidth * 0.4;
+    for (const el of view.querySelectorAll('[style*="background-color"], [style*="background:"]')) {
+      if (el.tagName === "IMG" || el.tagName === "VIDEO" || el.querySelector("img, video")) continue;
+      const st = el.style;
+      if (/url\(/.test(st.backgroundImage || st.background || "")) continue;
+      if (!/rgb|#/.test(st.backgroundColor || st.background || "")) continue;
+      const r = el.getBoundingClientRect();
+      if (r.width < min || r.height < 120) continue;
+      st.setProperty("background-color", "var(--spice-gradient-top)", "important");
+      st.setProperty("background-image", "linear-gradient(var(--spice-gradient-top), var(--spice-main))", "important");
+    }
+  }
+  let queued = false;
+  const schedule = () => {
+    if (queued) return;
+    queued = true;
+    requestAnimationFrame(() => { queued = false; neutralise(); });
+  };
+  new MutationObserver(schedule).observe(document.documentElement, {
+    subtree: true, childList: true, attributes: true, attributeFilter: ["style"],
+  });
+  schedule();
+})();
