 /**
  * Exposes the active Hyprland Xkb keyboard layout name and code for indicators.
+ *
+ * Hyprland sends one "activelayout" event per keyboard device, virtual ones
+ * included (power button, video bus, ...). Only the main keyboard (the one
+ * you type on) is trusted; after every burst of events the real state is
+ * read back once, so a device that drifted can never leave a wrong label.
+ * Layout names are turned into codes with a table read once at startup, so
+ * quick successive switches can't drop a lookup.
  */
 Singleton {
     id: root
@@ -18,61 +25,56 @@ Singleton {
     property string currentLayoutCode: ""
     // For the service
     property var baseLayoutFilePath: "/usr/share/X11/xkb/rules/base.lst"
