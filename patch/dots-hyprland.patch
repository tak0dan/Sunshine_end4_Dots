@@ -0,0 +1,551 @@
+#!/usr/bin/env python3
+"""Wallpaper-driven themes: a spicetify colour scheme, a btop theme and a recoloured icon theme.
+
+matugen runs this after every wallpaper change ([templates.wallpaper_theme] in
+~/.config/matugen/config.toml), with source.json holding the image path.
+
+The colours come from design.py, a fixed procedure: sample up to 100 shades
+of what is on screen, organise them into hue families (real tonal ramps),
+relate the families (complementary, analogous, ...), then fill fixed design
+system slots (surface ramp, text roles at fixed contrast, three balanced
+accent ramps, error) and run an adjustment pass. Every run also writes an
+inspection sheet with a Spotify preview (preview.html in the state folder).
+
+Usage: wallpaper-theme.py [SOURCE_JSON | IMAGE] [--print] [--no-apply]
+                          [--no-spicetify] [--no-btop] [--no-icons]
+       wallpaper-theme.py --preview OUT.html IMAGE     (writes nothing else)
+"""
+
+import configparser
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.realpath(__file__))
+sys.path.insert(0, HERE)
+from design import (BLACK, MIN_RYB_GAP, WHITE, checks, contrast, design, from_hex,  # noqa: E402
+                    from_lch, hue_gap, hue_name, lch, mix, organise, relate, ryb_gap,
+                    sample, to_hex, tone)
+from wallpaper_view import load_pixels  # noqa: E402
+
+HOME = os.path.expanduser("~")
+STATE = f"{HOME}/.local/state/quickshell/user/generated/wallpaper-theme"
+DEFAULT_SOURCE = f"{STATE}/source.json"
+SPICETIFY_THEME = f"{HOME}/.config/spicetify/Themes/Wallpaper"
+ICON_DIR = f"{HOME}/.local/share/icons"
+# Generated icon theme -> theme it recolours (and falls back to)
+ICON_VARIANTS = {"Wallpaper-dark": "breeze-plus-dark", "Wallpaper-light": "breeze-plus"}
+SYSTEM_ICONS = "/usr/share/icons"
+
+
+# ---------- what is on screen ----------
+
+def run_design(image=None, seed=None, primary=None):
+    """image (path) or seed (hex colour) -> (scene, relations, design)."""
+    if image:
+        px, rows = load_pixels(image)
+    else:
+        rgb = np.array([int(seed.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]) / 255
+        px, rows = np.tile(rgb, (64, 1)), np.linspace(0, 1, 64)
+    scene = organise(sample(px, rows))
+    rel = relate(scene)
+    return scene, rel, design(scene, rel, from_hex(primary) if primary else None)
+
+
+# ---------- btop ----------
+
+BTOP_THEME = f"{HOME}/.config/btop/themes/wallust.theme"
+
+# Colour theory for a monitoring UI, calibrated on matugen's (Material) btop
+# theme, whose restraint is what makes it readable:
+#  - hierarchy 60-30-10: neutral surfaces, the picture's own hue as the base,
+#    one opposite hue as the accent; one muted support hue, red only for
+#    hot / full states. Four hues, never the whole palette.
+#  - fixed tone ladder (OKLab L): container 0.41 -> main 0.82 -> light 0.91
+#  - chroma budget per role; the light end of a gradient at half chroma
+#  - the support hue is harmonised: turned up to 15 degrees toward the base,
+#    but never so far that the two read as one colour; red is left red
+#  - neutrals carry a trace of the base hue (Material's neutral-variant)
+BTOP_TONES = {"container": 0.41, "main": 0.82, "light": 0.91}
+BTOP_CHROMA = {"accent": 0.10, "base": 0.085, "support": 0.055, "error": 0.09}
+BTOP_NEUTRALS = {      # role: (L, C), measured from matugen's btop theme
+    "main_fg": (0.91, 0.020), "graph_text": (0.83, 0.031), "inactive_fg": (0.65, 0.030),
+    "div_line": (0.39, 0.029), "meter_bg": (0.33, 0.018)}
+HARMONISE = 15
+
+
+def harmonise(h, toward):
+    d = ((toward - h + 180) % 360) - 180
+    for step in range(HARMONISE, -1, -1):
+        out = (h + max(-step, min(step, d))) % 360
+        if ryb_gap(out, toward) >= MIN_RYB_GAP or step == 0:
+            return out
+    return h
+
+
+def btop_hues(d):
+    """Base, accent, support, error hues (OKLCH degrees) and whether the
+    picture has any colour at all."""
+    pal = d["palette"]["colours"]
+    base_src = next((c for c in pal if c["origin"] == "picture"), None)
+    if base_src is None:                       # grey picture: monochrome by design
+        h = lch(d["surfaces"]["page"])[2]
+        return {"base": h, "accent": h, "support": h, "error": 27.0}, False
+    base = base_src["hue"]
+    # accent: the design's opposite colour (desktop accent or painter's complement)
+    accent = lch(d["ramps"]["secondary"]["main"])[2]
+    if ryb_gap(accent, base) < 90:
+        accent = lch(d["ramps"]["tertiary"]["main"])[2]
+    # support: a second real picture colour, else the strongest analogous hue
+    others = [c for c in pal if c is not base_src and ryb_gap(c["hue"], base) >= MIN_RYB_GAP
+              and ryb_gap(c["hue"], accent) >= MIN_RYB_GAP]
+    sup = next((c for c in others if c["origin"] == "picture"), None) or \
+        next((c for c in others if c["relation"] == "analogous"), None)
+    support = harmonise(sup["hue"], base) if sup else (base + 30) % 360
+    # error: the palette's red if it has one, else red itself
+    red = min(pal, key=lambda c: hue_gap(c["hue"], 27))
+    error = red["hue"] if hue_gap(red["hue"], 27) <= 15 else 27.0
+    return {"base": base, "accent": accent, "support": support, "error": error}, True
+
+
+def btop_roles(d):
+    hues, coloured = btop_hues(d)
+    k = 1.0 if coloured else 0.0
+
+    def c(role, tone, half=False):
+        C = BTOP_CHROMA[role] * k * (0.5 if half else 1.0)
+        if role == "error":
+            C = BTOP_CHROMA[role] * (0.5 if half else 1.0)
+        return from_lch(BTOP_TONES[tone], C, hues[role])
+
+    def ramp(role):
+        return c(role, "container"), c(role, "main"), c(role, "light", half=True)
+
+    roles = {"main_bg": d["surfaces"]["page"]}
+    for name, (L, C) in BTOP_NEUTRALS.items():
+        roles[name] = from_lch(L, C * k, hues["base"])
+    roles["title"] = roles["main_fg"]
+    roles.update({
+        "hi_fg": c("accent", "main"), "selected_bg": c("accent", "container"),
+        "selected_fg": c("accent", "light", half=True), "proc_misc": c("base", "main"),
+        "cpu_box": c("accent", "main"), "mem_box": c("support", "main"),
+        "net_box": c("base", "main"), "proc_box": c("accent", "main"),
+        "temp_start": c("support", "main"), "temp_mid": c("base", "main"), "temp_end": c("error", "main"),
+    })
+    for name, role in (("cpu", "accent"), ("free", "base"), ("cached", "support"),
+                       ("available", "accent"), ("used", "support"), ("download", "accent"),
+                       ("upload", "support")):
+        roles[f"{name}_start"], roles[f"{name}_mid"], roles[f"{name}_end"] = ramp(role)
+    roles["used_end"] = c("error", "main")                  # a full disk is a warning
+    roles["process_start"], roles["process_mid"], roles["process_end"] = \
+        c("base", "main"), c("accent", "main"), c("error", "main")
+    return roles, hues
+
+
+def write_btop(d, source):
+    roles, hues = btop_roles(d)
+    lines = ["# btop theme generated from the wallpaper by",
+             "# ~/.config/matugen/templates/wallpaper-theme/wallpaper-theme.py",
+             f"# source: {source}",
+             "# hues: " + ", ".join(f"{k} {hue_name(h)} {h:.0f}" for k, h in hues.items()), ""]
+    lines += [f'theme[{k}]="#{to_hex(v)}"' for k, v in roles.items()]
+    os.makedirs(os.path.dirname(BTOP_THEME), exist_ok=True)
+    tmp = BTOP_THEME + ".tmp"
+    with open(tmp, "w") as f:
+        f.write("\n".join(lines) + "\n")
+    os.replace(tmp, BTOP_THEME)
+    return lines
+
+
+# ---------- spicetify ----------
+
+def spicetify_roles(d):
+    """The design system's slots -> spicetify's colour keys (fixed table)."""
+    s, r = d["surfaces"], d["ramps"]
+    return {
+        "text": d["text"],
+        "subtext": d["subtext"],
+        "main": s["page"],
+        "main-elevated": s["elevated"],
+        "card": s["card"],
+        "highlight": s["highlight"],
+        "highlight-elevated": s["pressed"],
+        "sidebar": s["sidebar"],
+        "player": s["player"],
+        "tab-active": s["card"],
+        "misc": s["misc"],
+        "shadow": mix(s["player"], BLACK, 0.7),
+        "selected-row": d["text"],
+        "button": r["primary"]["main"],
+        "button-active": r["primary"]["soft"],
+        "button-disabled": d["disabled"],
+        "notification": r["secondary"]["main"],
+        "notification-error": r["error"]["main"],
+        # extra keys, exposed by spicetify as --spice-<name> / --spice-rgb-<name>
+        "secondary": r["secondary"]["main"],
+        "tertiary": r["tertiary"]["main"],
+        "primary-container": r["primary"]["container"],
+        "secondary-container": r["secondary"]["container"],
+        "tertiary-container": r["tertiary"]["container"],
+        "gradient-top": d["gradient_top"],
+    }
+
+
+def write_spicetify_assets(accent):
+    """Spotify draws its "now playing" bars from green image files that no
+    colour variable reaches; ship copies in the accent colour (spicetify
+    copies a theme's assets/ over the app's files, overwrite_assets = 1)."""
+    from PIL import Image, ImageSequence
+
+    src = "/opt/spotify/Apps/xpui/images"
+    out = f"{SPICETIFY_THEME}/assets/images"
+    os.makedirs(out, exist_ok=True)
+    hx = to_hex(accent)
+    rgb = [int(hx[i:i + 2], 16) for i in (0, 2, 4)]
+    backup = f"{STATE}/spotify-assets"     # pristine copies; the app's get replaced
+    os.makedirs(backup, exist_ok=True)
+    for name in ("equaliser-green.svg", "equaliser-animated-green.gif"):
+        orig = f"{backup}/{name}"
+        if not os.path.exists(orig):
+            if not os.path.exists(f"{src}/{name}"):
+                continue
+            shutil.copyfile(f"{src}/{name}", orig)
+        if name.endswith(".svg"):
+            with open(orig) as f:
+                svg = re.sub(r"#1DB954|#1ed760", f"#{hx}", f.read(), flags=re.I)
+            with open(f"{out}/{name}", "w") as f:
+                f.write(svg)
+            continue
+        im = Image.open(orig)
+        frames = []
+        for frame in ImageSequence.Iterator(im):
+            # Pillow hands later frames over as RGB(A); recolour the green pixels
+            px = np.array(frame.convert("RGBA"))
+            green = (np.abs(px[..., :3].astype(int) - [29, 185, 84]).sum(-1) < 60) & (px[..., 3] > 0)
+            px[green, :3] = rgb
+            frames.append(Image.fromarray(px, "RGBA"))
+        frames[0].save(f"{out}/{name}", save_all=True, append_images=frames[1:], loop=0,
+                       duration=im.info.get("duration", 30), disposal=2, optimize=False)
+
+
+def write_spicetify(d, source):
+    roles = spicetify_roles(d)
+    os.makedirs(SPICETIFY_THEME, exist_ok=True)
+    for name in ("user.css", "theme.js"):
+        shutil.copyfile(f"{HERE}/spicetify/{name}", f"{SPICETIFY_THEME}/{name}")
+    write_spicetify_assets(roles["tertiary"])     # "now playing" marks
+    lines = [f"; Generated by {os.path.basename(__file__)} from {source}",
+             f"; {d['kind']} scheme"] + [f"; {line}" for line in d["log"]] + ["[Wallpaper]"]
+    lines += [f"{k:<19} = {to_hex(v)}" for k, v in roles.items()]
+    tmp = f"{SPICETIFY_THEME}/color.ini.tmp"
+    with open(tmp, "w") as f:
+        f.write("\n".join(lines) + "\n")
+    os.replace(tmp, f"{SPICETIFY_THEME}/color.ini")
+    return lines
+
+
+# ---------- icon theme ----------
+#
+# Only the UI accent is recoloured, the way a designer would re-skin Breeze:
+#  - everywhere: the colour Breeze assigns to .ColorScheme-Accent and
+#    .ColorScheme-Highlight (selection marks, active states, ...)
+#  - in places/: every Breeze blue, i.e. the folders with all their shades
+# Literal blues elsewhere are app logos or carry meaning (info, links) and stay.
+
+BREEZE_BLUE = lch(from_hex("3daee9"))
+HEX_RE = re.compile(r"#([0-9a-fA-F]{6})\b")
+ROLE_RE = re.compile(r"(\.ColorScheme-(?:Accent|Highlight)\s*\{\s*color\s*:\s*)#([0-9a-fA-F]{6})")
+
+
+def icon_accent(d, dark):
+    """Folder colour: the primary accent's own shade at a lightness that sits
+    well on Breeze's surfaces (lighter on dark, deeper on light), at the
+    design's balanced accent chroma."""
+    C = lch(d["ramps"]["primary"]["main"])[1]
+    return tone(d["accent_src"][0], 0.72 if dark else 0.56, chroma=C if C > 0.02 else 0.0)
+
+
+def is_breeze_blue(hx):
+    L, C, h = lch(from_hex(hx))
+    return C >= 0.05 and hue_gap(h, BREEZE_BLUE[2]) <= 30
+
+
+def blue_mapper(target):
+    """Map Breeze blues to the target, keeping each shade's lightness and
+    saturation relative to Breeze's base blue, so the light and dark parts of
+    a folder keep their relationship."""
+    tL, tC, th = lch(target)
+    bL, bC, bh = BREEZE_BLUE
+    cache = {}
+
+    def mapped(hx):
+        hx = hx.lower()
+        if hx not in cache:
+            if is_breeze_blue(hx):
+                L, C, h = lch(from_hex(hx))
+                dh = ((h - bh + 180) % 360) - 180
+                cache[hx] = "#" + to_hex(from_lch(tL + (L - bL), C * tC / bC, th + dh))
+            else:
+                cache[hx] = "#" + to_hex(target)
+        return cache[hx]
+
+    def recolour(svg, in_places):
+        # One pass per file: a mapped colour can itself look like a Breeze
+        # blue, so running both substitutions would shift it twice.
+        if in_places:
+            return HEX_RE.sub(lambda m: mapped(m.group(1)) if is_breeze_blue(m.group(1).lower())
+                              else m.group(0), svg)
+        return ROLE_RE.sub(lambda m: m.group(1) + mapped(m.group(2)), svg)
+    return recolour
+
+
+def read_index(theme):
+    cp = configparser.ConfigParser(interpolation=None, strict=False)
+    cp.optionxform = str
+    cp.read(f"{SYSTEM_ICONS}/{theme}/index.theme")
+    return cp
+
+
+def theme_chain(name, seen=None):
+    seen = seen if seen is not None else []
+    if name in seen or name == "hicolor" or not os.path.isdir(f"{SYSTEM_ICONS}/{name}"):
+        return seen
+    seen.append(name)
+    for parent in read_index(name).get("Icon Theme", "Inherits", fallback="").split(","):
+        if parent.strip():
+            theme_chain(parent.strip(), seen)
+    return seen
+
+
+def affected_icons(chain):
+    """[(relative path, real file)] of icons the recolouring touches, in
+    lookup order. Scanning ~40k files is slow, so the list is cached until an
+    icon package changes."""
+    stamp = [[t, os.path.getmtime(f"{SYSTEM_ICONS}/{t}/index.theme")] for t in chain]
+    cache_file = f"{STATE}/icons-{chain[0]}.json"
+    try:
+        with open(cache_file) as f:
+            cached = json.load(f)
+        if cached["stamp"] == stamp:
+            return cached["icons"]
+    except (OSError, ValueError, KeyError):
+        pass
+
+    touched = {}    # real file -> bool
+    icons, seen = [], set()
+    for theme in chain:
+        root = f"{SYSTEM_ICONS}/{theme}"
+        # followlinks: Breeze's @2x/@3x directories are symlinks
+        for dirpath, _, files in os.walk(root, followlinks=True):
+            for fn in files:
+                if not fn.endswith(".svg"):
+                    continue
+                rel = os.path.relpath(os.path.join(dirpath, fn), root)
+                if rel in seen:     # an earlier theme in the chain wins
+                    continue
+                seen.add(rel)
+                real = os.path.realpath(os.path.join(dirpath, fn))
+                key = (real, rel.startswith("places/"))
+                if key not in touched:
+                    try:
+                        with open(real, encoding="utf-8") as f:
+                            svg = f.read()
+                    except (OSError, UnicodeDecodeError):
+                        touched[key] = False
+                        continue
+                    touched[key] = bool(ROLE_RE.search(svg)) or (
+                        key[1] and any(is_breeze_blue(h.lower()) for h in set(HEX_RE.findall(svg))))
+                if touched[key]:
+                    icons.append([rel, real])
+    os.makedirs(STATE, exist_ok=True)
+    with open(cache_file, "w") as f:
+        json.dump({"stamp": stamp, "icons": icons}, f)
+    return icons
+
+
+def write_icon_theme(name, base, target):
+    chain = theme_chain(base)
+    recolour = blue_mapper(target)
+    out = f"{ICON_DIR}/{name}"
+    tmp = f"{out}.new"
+    shutil.rmtree(tmp, ignore_errors=True)
+
+    written = {}    # (real file, in places) -> first path we wrote it to
+    used_dirs = set()
+    for rel, real in affected_icons(chain):
+        key = (real, rel.startswith("places/"))
+        dst = os.path.join(tmp, rel)
+        os.makedirs(os.path.dirname(dst), exist_ok=True)
+        if key in written:
+            os.symlink(os.path.relpath(written[key], os.path.dirname(dst)), dst)
+        else:
+            with open(real, encoding="utf-8") as f:
+                svg = recolour(f.read(), key[1])
+            with open(dst, "w", encoding="utf-8") as f:
+                f.write(svg)
+            written[key] = dst
+        used_dirs.add(os.path.dirname(rel))
+
+    # index.theme: only the directories we filled, sections copied from the chain
+    sections = {}
+    for theme in reversed(chain):
+        cp = read_index(theme)
+        for s in cp.sections():
+            if s != "Icon Theme":
+                sections[s] = dict(cp[s])
+    dirs = sorted(d for d in used_dirs if d in sections)
+    lines = ["[Icon Theme]",
+             f"Name={name.replace('-', ' ').title()}",
+             f"Comment={base} recoloured to the wallpaper accent #{to_hex(target)}",
+             f"Inherits={base},hicolor",
+             # Colours are baked in; KDE must not repaint them with its own accent,
+             # or Dolphin and GTK apps would disagree.
+             "FollowsColorScheme=false",
+             "Example=folder",
+             "Directories=" + ",".join(d for d in dirs if "@" not in d),
+             "ScaledDirectories=" + ",".join(d for d in dirs if "@" in d), ""]
+    for d in dirs:
+        lines.append(f"[{d}]")
+        lines += [f"{k}={v}" for k, v in sections[d].items()]
+        lines.append("")
+    with open(f"{tmp}/index.theme", "w") as f:
+        f.write("\n".join(lines))
+    subprocess.run(["gtk-update-icon-cache", "-q", "-f", "-t", tmp],
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    old = f"{out}.old"
+    shutil.rmtree(old, ignore_errors=True)
+    if os.path.exists(out):
+        os.rename(out, old)
+    os.rename(tmp, out)
+    shutil.rmtree(old, ignore_errors=True)
+    return len(written)
+
+
+def refresh_icons():
+    """Make running apps reload icons even though the theme name is unchanged."""
+    try:
+        scheme = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
+                                capture_output=True, text=True).stdout
+    except FileNotFoundError:
+        return
+    name = "Wallpaper-dark" if "dark" in scheme else "Wallpaper-light"
+    base = ICON_VARIANTS[name]
+    # GTK: only reloads on a name change, so flip to the base theme and back
+    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", base])
+    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name])
+    for ini in (f"{HOME}/.config/gtk-3.0/settings.ini", f"{HOME}/.config/gtk-4.0/settings.ini"):
+        if os.path.isfile(ini):
+            with open(ini) as f:
+                s = f.read()
+            if "gtk-icon-theme-name=" in s:
+                s = re.sub(r"(?m)^gtk-icon-theme-name=.*$", f"gtk-icon-theme-name={name}", s)
+                with open(ini, "w") as f:
+                    f.write(s)
+    # KDE/Qt: set the theme and tell KIconLoader in every app to reload
+    subprocess.run(["kwriteconfig6", "--file", "kdeglobals", "--group", "Icons", "--key", "Theme", name],
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    for group in range(6):
+        subprocess.run(["dbus-send", "--session", "--type=signal", "/KIconLoader",
+                        "org.kde.KIconLoader.iconChanged", f"int32:{group}"],
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    # What Plasma's icon settings send too (KGlobalSettings: 4 = IconChanged),
+    # so apps rebuild views that keep their own icon pictures
+    subprocess.run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
+                    "org.kde.KGlobalSettings.notifyChange", "int32:4", "int32:0"],
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+
+def main():
+    flags = {a for a in sys.argv[1:] if a.startswith("--")}
+    args = [a for a in sys.argv[1:] if not a.startswith("--")]
+
+    if "--preview" in flags:
+        out, image = args[0], args[1]
+        import preview
+        primary = None
+        try:    # the current wallpaper: use the desktop's primary, as the live run does
+            with open(DEFAULT_SOURCE) as f:
+                data = json.load(f)
+            if os.path.realpath(data.get("image", "")) == os.path.realpath(image):
+                primary = data.get("primary")
+        except (OSError, ValueError):
+            pass
+        scene, rel, d = run_design(image=image, primary=primary)
+        preview.write(out, image, scene, rel, d, spicetify_roles(d), checks(d), btop_roles(d)[0])
+        return
+
+    src = args[0] if args else DEFAULT_SOURCE
+    image, seed, primary = src, None, None
+    if src.endswith(".json"):
+        with open(src) as f:
+            data = json.load(f)
+        image, seed, primary = data.get("image", ""), data.get("source_color"), data.get("primary")
+    if not primary:
+        try:    # older source.json, or an image given directly: matugen's last palette
+            with open(f"{HOME}/.local/state/quickshell/user/generated/colors.json") as f:
+                primary = json.load(f).get("primary")
+        except (OSError, ValueError):
+            pass
+
+    if image and os.path.isfile(image):
+        scene, rel, d = run_design(image=image, primary=primary)
+        source = image
+    elif seed:
+        # Colour-only mode in quickshell: one colour, no image
+        scene, rel, d = run_design(seed=seed)
+        source = seed
+    else:
+        sys.exit(f"no usable image or colour in {src}")
+
+    os.makedirs(STATE, exist_ok=True)
+    roles = spicetify_roles(d)
+    with open(f"{STATE}/palette.json", "w") as f:
+        json.dump({"source": source, "scheme": d["kind"], "log": d["log"],
+                   **{k: "#" + to_hex(v) for k, v in roles.items()}}, f, indent=2)
+    try:
+        import preview
+        preview.write(f"{STATE}/preview.html", image if image and os.path.isfile(image) else None,
+                      scene, rel, d, roles, checks(d), btop_roles(d)[0])
+    except Exception as e:      # the sheet is for inspection; never block theming
+        print(f"preview failed: {e}", file=sys.stderr)
+
+    if "--no-btop" not in flags:
+        # first: quick, and the one people look at right after a change
+        lines = write_btop(d, source)
+        if "--print" in flags:
+            print("\n".join(lines))
+        if "--no-apply" not in flags:
+            # SIGUSR2 makes btop reload its config and theme
+            subprocess.run(["pkill", "-USR2", "-x", "btop"],
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    if "--no-spicetify" not in flags:
+        lines = write_spicetify(d, source)
+        if "--print" in flags:
+            print("\n".join(lines))
+        if "--no-apply" not in flags:
+            # Copies the colours into Spotify without restarting it; theme.js
+            # picks them up live. Does nothing if spicetify is not set up.
+            subprocess.run(["spicetify", "refresh", "-n", "-q"],
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    if "--no-icons" not in flags:
+        for name, base in ICON_VARIANTS.items():
+            if os.path.isdir(f"{SYSTEM_ICONS}/{base}"):
+                target = icon_accent(d, dark=name.endswith("dark"))
+                n = write_icon_theme(name, base, target)
+                if "--print" in flags:
+                    print(f"{name}: {n} icons recoloured to #{to_hex(target)}")
+        if "--no-apply" not in flags:
+            refresh_icons()
+
+
+if __name__ == "__main__":
+    main()
