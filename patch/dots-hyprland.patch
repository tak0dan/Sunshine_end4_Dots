+"""Inspection sheet: the wallpaper, a Spotify replica painted with the
+generated roles, and every stage of the design procedure."""
+
+import base64
+import html
+import io
+import os
+
+import numpy as np
+
+from design import contrast, hue_gap, lch, palette_lab, to_hex
+
+
+def _img_uri(img, width, quality=82):
+    im = img.copy()
+    im.thumbnail((width, width))
+    buf = io.BytesIO()
+    im.convert("RGB").save(buf, "JPEG", quality=quality)
+    return "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()
+
+
+def _covers(img, n=10):
+    """Square crops of the wallpaper, used as album art in the replica."""
+    w, h = img.size
+    side = min(w, h) // 3
+    out = []
+    for i in range(n):
+        x = int((w - side) * ((i * 0.37) % 1))
+        y = int((h - side) * ((i * 0.61) % 1))
+        out.append(_img_uri(img.crop((x, y, x + side, y + side)), 220, 75))
+    return out
+
+
+def _sw(lab, label="", size=28, title=""):
+    hx = to_hex(lab)
+    tip = html.escape(title or f"#{hx}")
+    return (f'<div class="sw" style="background:#{hx};width:{size}px;height:{size}px" title="{tip}">'
+            f'{html.escape(label)}</div>')
+
+
+def write(path, image, scene, rel, d, roles, checks, btop=None):
+    from PIL import Image
+    import wallpaper_view
+
+    name = os.path.basename(image) if image else "colour"
+    if image:
+        view = wallpaper_view.visible(Image.open(image).convert("RGB"))
+        wall = _img_uri(view, 900)
+        covers = _covers(view)
+    else:
+        wall, covers = "", [""] * 10
+    v = {k: "#" + to_hex(c) for k, c in roles.items()}
+    css_vars = ";".join(f"--{k}:{c}" for k, c in v.items())
+    r = d["ramps"]
+
+    def rgb(k):
+        h = v[k].lstrip("#")
+        return ",".join(str(int(h[i:i + 2], 16)) for i in (0, 2, 4))
+
+    # ---- design sheet parts ----
+    fams = scene["families"]
+    order = []
+    for f in sorted(fams, key=lambda f: f["hue"]):
+        order += f["shades"]
+    order += scene["neutral"]["shades"]
+    shades_html = "".join(_sw(s["lab"], size=18, title=f"#{to_hex(s['lab'])}  L{s['L']:.2f} C{s['C']:.3f} h{s['h']:.0f}  {s['share']:.1%}")
+                          for s in order)
+    share_bar = "".join(f'<div style="background:#{to_hex(s["lab"])};flex:{s["share"]:.4f}"></div>' for s in order)
+    fam_html = ""
+    for f in fams:
+        tag = " — page" if f is d["surface_src"] else ""
+        if any(f is (a.get("_family", a) if isinstance(a, dict) else None) for a in d["accent_src"]):
+            idx = next(i for i, a in enumerate(d["accent_src"]) if isinstance(a, dict) and a.get("_family", a) is f)
+            tag += " — " + ("primary", "secondary", "tertiary")[idx]
+        fam_html += (f'<div class="row"><div class="lbl">{f["hue"]:.0f}° · {f["share"]:.0%}{tag}</div>'
+                     + "".join(_sw(s["lab"], size=22, title=f"L{s['L']:.2f} C{s['C']:.3f} {s['share']:.1%}") for s in f["shades"])
+                     + "</div>")
+    if scene["neutral"]["shades"]:
+        fam_html += ('<div class="row"><div class="lbl">neutral · %.0f%%</div>' % (100 * scene["neutral"]["share"])
+                     + "".join(_sw(s["lab"], size=22) for s in scene["neutral"]["shades"]) + "</div>")
+    pairs_html = "".join(
+        f'<div class="row">{_sw(p["a"]["vivid"], size=22)}{_sw(p["b"]["vivid"], size=22)}'
+        f'<div class="lbl2">{p["a"]["hue"]:.0f}° ↔ {p["b"]["hue"]:.0f}° · gap {p["gap"]:.0f}° · '
+        f'complementary {p["complementary"]:.2f}</div></div>' for p in rel["pairs"][:5]) or "<div>no pairs</div>"
+    surf_html = "".join(_sw(c, k, 64) for k, c in d["surfaces"].items())
+    ramp_html = ""
+    for n in ("primary", "secondary", "tertiary", "error"):
+        ramp_html += f'<div class="row"><div class="lbl">{n}{" (made up)" if n in d["synthetic"] else ""}</div>' + \
+            "".join(_sw(c, t, 64) for t, c in r[n].items()) + "</div>"
+    text_html = "".join(_sw(c, k, 64) for k, c in (("text", d["text"]), ("subtext", d["subtext"]),
+                                                     ("disabled", d["disabled"]), ("gradient", d["gradient_top"])))
+    check_html = "".join(f'<tr><td>{html.escape(n)}</td><td>{c:.1f}:1</td><td>{t:.1f}:1</td>'
+                         f'<td class="{"ok" if c >= t else "bad"}">{"ok" if c >= t else "FAIL"}</td></tr>'
+                         for n, c, t in checks)
+    log_html = "".join(f"<li>{html.escape(x)}</li>" for x in d["log"])
+    pal = d.get("palette", {"colours": [], "gaps": []})
+    pal_html = "".join(
+        f'<div class="row">{_sw(palette_lab(c), c["id"], 40)}<div class="lbl2">{c["id"]} · {c["name"]} {c["hue"]:.0f}° · '
+        + (f'picture, {c["share"]:.0%} of the screen' if c["origin"] == "picture"
+           else f'{c["relation"]} of {c["parent"]}') + '</div></div>'
+        for c in pal["colours"]) or "<div>grey picture: no hues (monochrome by design)</div>"
+    pal_html += ('<div class="lbl2" style="margin-top:6px">gaps (painter\'s wheel): ' +
+                 (", ".join(f"{a}–{b} {g}°" for a, b, g in pal["gaps"]) or "one picture colour") + "</div>")
+    btop_html = ""
+    if btop:
+        groups = [("ui", ["main_fg", "hi_fg", "selected_bg", "selected_fg", "inactive_fg", "graph_text", "meter_bg", "div_line"]),
+                  ("boxes", ["cpu_box", "mem_box", "net_box", "proc_box", "proc_misc"]),
+                  ("temp", ["temp_start", "temp_mid", "temp_end"])] + \
+                 [(n, [f"{n}_start", f"{n}_mid", f"{n}_end"]) for n in
+                  ("cpu", "free", "cached", "available", "used", "download", "upload", "process")]
+        btop_html = "".join(f'<div class="row"><div class="lbl">{g}</div>' +
+                            "".join(_sw(btop[k], k.split("_", 1)[-1] if g not in ("ui", "boxes") else k, 54) for k in keys)
+                            + "</div>" for g, keys in groups)
+
+    # ---- Spotify replica ----
+    lib = "".join(f'<div class="lib-item"><img src="{covers[i]}"><div><div class="t">{t}</div>'
+                  f'<div class="s">{s}</div></div></div>'
+                  for i, (t, s) in enumerate([("Liked Songs", "Playlist · 412 songs"), ("Ticket to Hell", "Playlist · tak"),
+                                              ("НЕ КРИК НА ВУХО", "Playlist · tak"), ("Metalcore Mix", "Made for you"),
+                                              ("Ambient", "Playlist · Elder Evil"), ("Drudkh", "Artist"),
+                                              ("Release Radar", "Made for you")]))
+    shortcuts = "".join(f'<div class="short"><img src="{covers[i + 2]}"><span>{t}</span>'
+                        f'{"<i class=eq></i>" if i == 0 else ""}</div>'
+                        for i, t in enumerate(["Ticket to Hell", "НЕ КРИК НА ВУХО", "NEXT!", "Guardians of the Galaxy",
+                                               "Daily Mix 1", "Discover Weekly", "Liked Songs", "On Repeat"]))
+    cards = "".join(f'<div class="card{" hover" if i == 1 else ""}"><div class="art"><img src="{covers[i + 4]}">'
+                    f'{"<div class=play>▶</div>" if i == 1 else ""}</div><div class="t">{t}</div><div class="s">{s}</div></div>'
+                    for i, (t, s) in enumerate([("Metalcore Mix", "Spiritbox, NOTHING MORE, Thornhill"),
+                                                ("Metal Mix", "Leprous, VOLA, Sleep Token"),
+                                                ("Discover Weekly", "Your weekly mixtape"),
+                                                ("Daily Mix 2", "Drudkh, Wolves in the Throne Room"),
+                                                ("Chill Mix", "Bonobo, Tycho, Emancipator")]))
