+++ b/dots/.config/matugen/templates/wallpaper-theme/wallpaper_view.py
@@ -0,0 +1,62 @@
+"""What quickshell actually shows of the wallpaper, as pixels."""
+
+import json
+import os
+import subprocess
+
+import numpy as np
+
+HOME = os.path.expanduser("~")
+
+
+def screen_size():
+    """Focused monitor in logical pixels; 1920x1080 if Hyprland can't say."""
+    try:
+        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True,
+                             timeout=2).stdout
+        mon = next((m for m in json.loads(out) if m.get("focused")), None)
+        if mon:
+            return mon["width"] / mon["scale"], mon["height"] / mon["scale"]
+    except (OSError, ValueError, subprocess.SubprocessError):
+        pass
+    return 1920, 1080
+
+
+def visible(img):
+    """The part of the wallpaper quickshell actually shows: it scales the image
+    to cover the screen, zooms in a little more for parallax, and centres it."""
+    sw, sh = screen_size()
+    zoom = 1.07
+    try:
+        with open(f"{HOME}/.config/illogical-impulse/config.json") as f:
+            zoom = json.load(f)["background"]["parallax"]["workspaceZoom"]
+    except (OSError, ValueError, KeyError):
+        pass
+    w, h = img.size
+    scale = max(sw / w, sh / h) * zoom
+    vw, vh = min(w, sw / scale), min(h, sh / scale)
+    # Horizontally the view pans across workspaces, so keep its full range
+    vw = min(w, vw * zoom)
+    left, top = (w - vw) / 2, (h - vh) / 2
+    return img.crop((round(left), round(top), round(left + vw), round(top + vh)))
+
+
+def load_pixels(path):
+    from PIL import Image
+
+    img = visible(Image.open(path))
+    img.thumbnail((256, 256))
+    if img.mode in ("I", "I;16", "I;16B", "I;16L", "F"):
+        # 16-bit/float greyscale: Pillow's RGB conversion would clip it
+        grey = np.asarray(img, dtype=float)
+        grey /= 65535 if grey.max() > 255 else 255
+        rows = np.repeat(np.linspace(0, 1, img.height), img.width)
+        return np.repeat(grey.reshape(-1, 1), 3, axis=1), rows
+    if img.mode in ("RGBA", "LA", "P"):
+        img = img.convert("RGBA")
+        px = np.asarray(img, dtype=float).reshape(-1, 4) / 255
+        rows = np.repeat(np.linspace(0, 1, img.height), img.width)
+        keep = px[:, 3] > 0.5               # ignore transparent areas
+        return px[keep][:, :3], rows[keep]
+    rows = np.repeat(np.linspace(0, 1, img.height), img.width)   # 0 = top of the screen
+    return np.asarray(img.convert("RGB"), dtype=float).reshape(-1, 3) / 255, rows
