+/* Wallpaper theme: colours come from color.ini, generated by
+   ~/.config/matugen/templates/wallpaper-theme/wallpaper-theme.py.
+   Map Spotify's own design tokens onto them so every surface follows. */
+:root,
+.encore-dark-theme,
+.encore-dark-theme .encore-base-set,
+.encore-light-theme,
+.encore-light-theme .encore-base-set,
+.encore-layout-themes {
+  --background-base: var(--spice-main) !important;
+  --background-highlight: var(--spice-highlight) !important;
+  --background-press: var(--spice-highlight-elevated) !important;
+  --background-elevated-base: var(--spice-main-elevated) !important;
+  --background-elevated-highlight: var(--spice-highlight-elevated) !important;
+  --background-elevated-press: var(--spice-highlight-elevated) !important;
+  /* chips and tinted buttons: the secondary accent, lightly */
+  --background-tinted-base: rgba(var(--spice-rgb-secondary), 0.16) !important;
+  --background-tinted-highlight: rgba(var(--spice-rgb-secondary), 0.24) !important;
+  --background-tinted-press: rgba(var(--spice-rgb-secondary), 0.32) !important;
+  --text-base: var(--spice-text) !important;
+  --text-subdued: var(--spice-subtext) !important;
+  --essential-base: var(--spice-text) !important;
+  --essential-subdued: var(--spice-button-disabled) !important;
+  --decorative-base: var(--spice-text) !important;
+  --decorative-subdued: rgba(var(--spice-rgb-text), 0.12) !important;     /* dividers */
+}
+
+/* Spotify's green, wherever it is a token (including the per-album
+   "extracted" variants) */
+:root, .encore-dark-theme, .encore-light-theme,
+.encore-dark-theme .encore-base-set, .encore-light-theme .encore-base-set,
+.encore-dark-theme .encore-bright-accent-set, .encore-light-theme .encore-bright-accent-set,
+[class*="encore-"] {
+  --text-bright-accent: var(--spice-button) !important;
+  --essential-bright-accent: var(--spice-button) !important;
+  /* liked / added / downloaded: the secondary accent, so the palette's
+     second colour shows up beside the primary */
+  --text-positive: var(--spice-secondary) !important;
+  --essential-positive: var(--spice-secondary) !important;
+  --extracted-text-bright-accent: var(--spice-button) !important;
+  --text-negative: var(--spice-notification-error) !important;
+  --essential-negative: var(--spice-notification-error) !important;
+  --text-announcement: var(--spice-tertiary) !important;
+  --essential-announcement: var(--spice-tertiary) !important;
+  --text-warning: var(--spice-tertiary) !important;
+  --essential-warning: var(--spice-tertiary) !important;
+}
+
+/* Accent-filled buttons (play, follow, ...): the label uses the page colour,
+   which the generator keeps at 3:1 or more against the accent. */
+.encore-dark-theme .encore-bright-accent-set,
+.encore-light-theme .encore-bright-accent-set,
+.encore-bright-accent-set {
+  --background-base: var(--spice-button) !important;
+  --background-highlight: var(--spice-button-active) !important;
+  --background-press: var(--spice-button-active) !important;
+  --text-base: var(--spice-main) !important;
+  --essential-base: var(--spice-main) !important;
+}
+
+/* Places where the green is a literal colour, not a token */
+[role="menuitemradio"][aria-checked="true"],
+[role="menuitemcheckbox"][aria-checked="true"] { color: var(--spice-button) !important; }
+input:checked ~ .x-toggle-indicatorWrapper,
+input:checked:hover:not([disabled], :active) ~ .x-toggle-indicatorWrapper {
+  background-color: var(--spice-button) !important;
+}
+/* What is playing right now: the tertiary accent, like the "now playing" bars */
+.main-trackList-playingIcon, .main-trackList-rowTitle[data-is-playing="true"],
+[aria-current="true"] .encore-text-body-medium { color: var(--spice-tertiary) !important; }
+
+/* Frame around the panels and the player bar: one step below the panels.
+   Only on body: a background on .Root__top-container or #main would paint
+   over the Canvas video, which sits behind the right panel at z-index -1. */
+body { background-color: var(--spice-player) !important; }
+.Root__now-playing-bar, footer[data-testid="now-playing-bar"] {
+  background-color: var(--spice-player) !important;
+}
+/* Panels take --background-base from the tokens above. No forced background
+   here: the right-hand panel plays a track's Canvas video behind its content,
+   and an opaque panel would hide it. */
+
+/* Album-art tints: Spotify sets these inline per element from the cover.
+   A stylesheet !important beats a normal inline value, so the wallpaper
+   palette wins. Large inline colour blocks (home and album headers) get the
+   wallpaper header gradient from theme.js. The lyrics card keeps the cover's
+   colours. */
+* {
+  --extracted-background-color: var(--spice-main-elevated) !important;
+  --extracted-background-tinted: rgba(var(--spice-rgb-text), 0.1) !important;
+  --extracted-entity-color: var(--spice-main-elevated) !important;
+  --extracted-text-base: var(--spice-text) !important;
+  --extracted-text-subdued: var(--spice-subtext) !important;
+  --extracted-text-bright-accent: var(--spice-button) !important;
+}
