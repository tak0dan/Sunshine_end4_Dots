index 00000000..6f4c1ed4
--- /dev/null
+++ b/dots/.config/fastfetch/custom-info.sh
@@ -0,0 +1,142 @@
+#!/usr/bin/env bash
+
+color() {
+    local code="$1"
+    shift
+    printf '\033[%sm%s\033[0m' "$code" "$*"
+}
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+JSON="$HOME/.config/fastfetch/from_tak_0/custom-info.json"
+if [[ ! -f "$JSON" ]]; then
+    JSON="${SCRIPT_DIR}/custom-info.json"
+fi
+
+if [[ ! -f "$JSON" ]]; then
+    printf '%s\n' "$(color "35" "│ └󰅙 Missing custom-info.json")"
+    exit 1
+fi
+
+# Parse JSON and compute durations using Python (no jq dependency).
+# Each entry may set:
+#   "units": any of years, months, weeks, days, hours, minutes
+#            (default: ["years", "months"])
+#   "mode":  "combined" -> one line, units break the span down
+#                          (e.g. "2 years 7 months")
+#            "total"    -> one line per unit, each the whole span in that unit
+#                          (e.g. "6 months", "193 days", "278123 minutes")
+# Output per entry: title|since|line1<TAB>line2...
+mapfile -t entries < <(python3 - "$JSON" <<'PY'
+import json, sys
+from datetime import datetime
+
+ORDER = ["years", "months", "weeks", "days", "hours", "minutes"]
+SECONDS = {"weeks": 604800, "days": 86400, "hours": 3600, "minutes": 60}
+
+def plural(n, unit):
+    return f"{n} {unit[:-1] if n == 1 else unit}"
+
+def add_months(dt, n):
+    y, m = divmod(dt.month - 1 + n, 12)
+    y += dt.year
+    m += 1
+    # Clamp day for short months (e.g. Jan 31 + 1 month -> Feb 28)
+    for d in range(dt.day, 0, -1):
+        try:
+            return dt.replace(year=y, month=m, day=d)
+        except ValueError:
+            pass
+
+def whole_months(start, now):
+    n = (now.year - start.year) * 12 + now.month - start.month
+    if add_months(start, n) > now:
+        n -= 1
+    return max(n, 0)
+
+def total(start, now, unit):
+    if unit == "years":
+        return whole_months(start, now) // 12
+    if unit == "months":
+        return whole_months(start, now)
+    return int((now - start).total_seconds()) // SECONDS[unit]
+
+def combined(start, now, units):
+    parts, cursor = [], start
+    for unit in [u for u in ORDER if u in units]:
+        if unit in ("years", "months"):
+            n = whole_months(cursor, now)
+            if unit == "years":
+                n //= 12
+                cursor = add_months(cursor, n * 12)
+            else:
+                cursor = add_months(cursor, n)
+        else:
+            n = int((now - cursor).total_seconds()) // SECONDS[unit]
+            cursor = datetime.fromtimestamp(cursor.timestamp() + n * SECONDS[unit])
+        if n:
+            parts.append(plural(n, unit))
+    if not parts:
+        smallest = [u for u in ORDER if u in units][-1]
+        parts.append(plural(0, smallest))
+    return " ".join(parts)
+
+try:
+    with open(sys.argv[1]) as f:
+        data = json.load(f)
+except Exception as e:
+    sys.exit(f"ERROR: {e}")
+
+now = datetime.now()
+for entry in data.get("entries", []):
+    title = entry.get("title", "")
+    since = entry.get("since", "")
+    units = [u for u in entry.get("units", ["years", "months"]) if u in ORDER] or ["years", "months"]
+    mode = entry.get("mode", "combined")
+    try:
+        start = datetime.fromisoformat(since)
+        if mode == "total":
+            lines = [plural(total(start, now, u), u) for u in units]
+        else:
+            lines = [combined(start, now, units)]
+    except ValueError:
+        lines = ["invalid date"]
+    print(f"{title}|{since}|" + "\t".join(lines))
+PY
+)
+
+if [[ ${#entries[@]} -eq 0 ]]; then
+    printf '%s\n' "$(color "35" "│ └󰅙 No entries found")"
+    exit 0
+fi
+
+for index in "${!entries[@]}"; do
+    line="${entries[$index]}"
+    IFS='|' read -r title since durations <<< "$line"
+
+    [[ -z "$title" || -z "$since" ]] && continue
+
+    IFS=$'\t' read -r -a lines <<< "$durations"
+
+    branch="├"
+    detail_prefix="│"
+    if (( index == ${#entries[@]} - 1 )); then
+        branch="└"
+        detail_prefix=" "
+    fi
+
+    # First entry is always rose; the rest cycle through the terminal's own
+    # palette so they follow whatever colour scheme is active.
+    if (( index == 0 )); then
+        title_color="38;2;255;102;153"
+    else
+        palette=(34 36 32 33 35)
+        title_color="${palette[(index - 1) % ${#palette[@]}]}"
+    fi
+
+    printf '%s %s\n' "$(color "$title_color" "│ ${branch}󰃭 $title")" "$(color "90" "(since $since)")"
+    for i in "${!lines[@]}"; do
+        sub="├"
+        (( i == ${#lines[@]} - 1 )) && sub="└"
+        printf '%s\n' "$(color "90" "│ ${detail_prefix} ${sub}${lines[$i]}")"
+    done
+done
